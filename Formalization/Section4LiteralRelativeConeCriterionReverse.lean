import Formalization.Section4NativeConeCriterionReverse
import Formalization.Section4LiteralConeHomotopyDescent

set_option linter.style.header false
set_option backward.isDefEq.respectTransparency false

/-!
# Section 4: the reverse literal-cone criterion for an arbitrary boundary

The pointed reverse cone criterion was previously stated only for the
subcomplex generated by one vertex.  The transgression needs the same HEP
argument for the whole bottom of a cone.  This file carries out the generic
version: if `P` contains a vertex, every native nullhomotopy relative to `P`
extends over the literal `Option` cone and vanishes on the cone swept out by
`P`.
-/

noncomputable section

open CategoryTheory CategoryTheory.Category Opposite Simplicial
open MonoidalCategory CartesianMonoidalCategory

namespace GeneralSphereT.SimplicialCochain

open GeneralSphereT.Section4
open GeneralSphereT.Section4.UnderlyingSSet
open GeneralSphereT.Section4.RelativeMapping
open GeneralSphereT.Section4.NativeRelativeHomotopyGroup

universe u

variable {V : Type u} [LinearOrder V] [Fintype V]
variable (M : AbstractSimplicialComplex V)

local instance (priority := 10000) relativeReverseOptionLE : LE (Option V) :=
  @WithBot.instLE V inferInstance
local instance (priority := 10000) relativeReverseOptionLT : LT (Option V) :=
  @WithBot.instLT V inferInstance
local instance (priority := 10000) relativeReverseOptionLinearOrder :
    LinearOrder (Option V) := @WithBot.linearOrder V inferInstance

variable (P : (orderedComplexSSet M).Subcomplex)

/-- The whole cone swept out by an arbitrary source subcomplex `P`. -/
def literalConeRelativeBaseLineMap :
    (P : SSet) ⊗ Δ[1] ⟶ orderedComplexSSet (simplicialCone M) :=
  (P.ι ≫ literalConeBottomMap M) ▷ Δ[1] ≫ literalConeCylinderMap M

abbrev literalConeRelativeBaseLineRange :
    (orderedComplexSSet (simplicialCone M)).Subcomplex :=
  SSet.Subcomplex.range (literalConeRelativeBaseLineMap M P)

/-- The copy of `P` in the bottom face of the literal cone. -/
abbrev literalConeRelativeBottomRange :
    (orderedComplexSSet (simplicialCone M)).Subcomplex :=
  SSet.Subcomplex.range (P.ι ≫ literalConeBottomMap M)

@[reassoc]
theorem ι₁_literalConeRelativeBaseLineMap :
    SSet.ι₁ ≫ literalConeRelativeBaseLineMap M P =
      P.ι ≫ literalConeBottomMap M := by
  rw [literalConeRelativeBaseLineMap, ← Category.assoc, SSet.ι₁_comp,
    Category.assoc, ι₁_literalConeCylinderMap, Category.comp_id]

@[reassoc]
theorem ι₀_literalConeRelativeBaseLineMap :
    SSet.ι₀ ≫ literalConeRelativeBaseLineMap M P =
      SSet.const (literalConeApex M) := by
  rw [literalConeRelativeBaseLineMap, ← Category.assoc, SSet.ι₀_comp,
    Category.assoc, ι₀_literalConeCylinderMap]
  exact SSet.comp_const P.ι (literalConeApex M)

theorem literalConeRelativeBottomRange_le_bottomRange :
    literalConeRelativeBottomRange M P ≤ literalConeBottomRange M := by
  intro Delta z hz
  rcases hz with ⟨x, hx⟩
  exact ⟨P.ι.app Delta x, hx⟩

theorem literalConeRelativeBottomRange_le_baseLineRange :
    literalConeRelativeBottomRange M P ≤
      literalConeRelativeBaseLineRange M P := by
  intro Delta z hz
  rcases hz with ⟨x, hx⟩
  refine ⟨SSet.ι₁.app Delta x, ?_⟩
  change (SSet.ι₁ ≫ literalConeRelativeBaseLineMap M P).app Delta x = z
  rw [ι₁_literalConeRelativeBaseLineMap]
  exact hx

/-- The two pieces of the relative cone boundary meet precisely in the
bottom copy of `P`. -/
theorem literalCone_relative_ranges_inf_eq :
    literalConeBottomRange M ⊓ literalConeRelativeBaseLineRange M P =
      literalConeRelativeBottomRange M P := by
  apply le_antisymm
  · intro Delta z hz
    rcases hz with ⟨⟨x, hx⟩, ⟨y, hy⟩⟩
    refine ⟨y.1, ?_⟩
    apply Subtype.ext
    apply OrderHom.ext
    funext i
    have hi := congrArg (fun w => w.1 i) (hx.trans hy.symm)
    have ht : SSet.stdSimplex.asOrderHom y.2 i ≠ 0 := by
      intro ht
      change some (x.1 i) =
        (if SSet.stdSimplex.asOrderHom y.2 i = 0 then none
          else some ((P.ι.app Delta y.1).1 i)) at hi
      rw [ht] at hi
      cases hi
    have hxy : x.1 i = (P.ι.app Delta y.1).1 i := by
      change some (x.1 i) =
        (if SSet.stdSimplex.asOrderHom y.2 i = 0 then none
          else some ((P.ι.app Delta y.1).1 i)) at hi
      have hi' : some (x.1 i) =
          some ((P.ι.app Delta y.1).1 i) := by
        simpa [ht] using hi
      exact Option.some.inj hi'
    change some ((P.ι.app Delta y.1).1 i) = z.1 i
    rw [← hx]
    simp only
    exact congrArg some hxy.symm
  · exact le_inf
      (literalConeRelativeBottomRange_le_bottomRange M P)
      (literalConeRelativeBottomRange_le_baseLineRange M P)

/-- The boundary used by the relative HEP: the bottom face together with
the cone on `P`. -/
def literalConeRelativeBoundarySubcomplex :
    (orderedComplexSSet (simplicialCone M)).Subcomplex :=
  literalConeBottomRange M ⊔ literalConeRelativeBaseLineRange M P

def literalConeRelativeBoundaryBicartSq :
    SSet.Subcomplex.BicartSq
      (literalConeRelativeBottomRange M P)
      (literalConeBottomRange M)
      (literalConeRelativeBaseLineRange M P)
      (literalConeRelativeBoundarySubcomplex M P) where
  sup_eq := rfl
  inf_eq := literalCone_relative_ranges_inf_eq M P

/-- The bottom copy of `P`, followed by the inverse of the bottom range
factorization, is the original inclusion of `P`. -/
theorem relativeBottomRange_inv_toRange :
    SSet.Subcomplex.toRange (P.ι ≫ literalConeBottomMap M) ≫
        SSet.Subcomplex.homOfLE
          (literalConeRelativeBottomRange_le_bottomRange M P) ≫
        inv (SSet.Subcomplex.toRange (literalConeBottomMap M)) =
      P.ι := by
  have he :
      SSet.Subcomplex.toRange (P.ι ≫ literalConeBottomMap M) ≫
          SSet.Subcomplex.homOfLE
            (literalConeRelativeBottomRange_le_bottomRange M P) =
        P.ι ≫ SSet.Subcomplex.toRange (literalConeBottomMap M) := by
    rw [← cancel_mono (literalConeBottomRange M).ι]
    simp only [Category.assoc, SSet.Subcomplex.homOfLE_ι,
      SSet.Subcomplex.toRange_ι]
  rw [← Category.assoc, he, Category.assoc, IsIso.hom_inv_id,
    Category.comp_id]

instance whiskerRight_relativeBottomToRange_epi (T : SSet.{u}) :
    Epi (SSet.Subcomplex.toRange
      (P.ι ≫ literalConeBottomMap M) ▷ T) := by
  rw [NatTrans.epi_iff_epi_app]
  intro Delta
  rw [epi_iff_surjective]
  rintro ⟨z, t⟩
  have hepi := (NatTrans.epi_iff_epi_app
    (SSet.Subcomplex.toRange
      (P.ι ≫ literalConeBottomMap M))).mp inferInstance Delta
  rw [epi_iff_surjective] at hepi
  rcases hepi z with ⟨x, rfl⟩
  exact ⟨(x, t), rfl⟩

theorem bottomRangeHomotopy_zero_on_relativeIntersection
    (A : SimplicialObject AddCommGrpCat.{u})
    (h : orderedComplexSSet M ⊗ Δ[1] ⟶ underlyingSSet A)
    (hrel : P.ι ▷ Δ[1] ≫ h = 0) :
    SSet.Subcomplex.homOfLE
          (literalConeRelativeBottomRange_le_bottomRange M P) ▷ Δ[1] ≫
        bottomRangeHomotopy M h = 0 := by
  rw [← cancel_epi
    (SSet.Subcomplex.toRange
      (P.ι ≫ literalConeBottomMap M) ▷ Δ[1])]
  calc
    _ = ((SSet.Subcomplex.toRange
              (P.ι ≫ literalConeBottomMap M) ≫
            SSet.Subcomplex.homOfLE
              (literalConeRelativeBottomRange_le_bottomRange M P) ≫
            inv (SSet.Subcomplex.toRange (literalConeBottomMap M))) ▷
          Δ[1]) ≫ h := by
      simp only [bottomRangeHomotopy, comp_whiskerRight_assoc,
        Category.assoc]
    _ = P.ι ▷ Δ[1] ≫ h := by
      rw [relativeBottomRange_inv_toRange]
    _ = 0 := hrel
    _ = SSet.Subcomplex.toRange
          (P.ι ≫ literalConeBottomMap M) ▷ Δ[1] ≫ 0 := by
      rfl

/-- Glue a relative homotopy on the bottom to the zero homotopy on the
whole cone over `P`. -/
def literalConeRelativeBoundaryHomotopy
    (A : SimplicialObject AddCommGrpCat.{u})
    (h : orderedComplexSSet M ⊗ Δ[1] ⟶ underlyingSSet A)
    (hrel : P.ι ▷ Δ[1] ≫ h = 0) :
    (literalConeRelativeBoundarySubcomplex M P : SSet) ⊗ Δ[1] ⟶
      underlyingSSet A := by
  let sq := literalConeRelativeBoundaryBicartSq M P
  let push := (SSet.Subcomplex.BicartSq.isPushout sq).map
    (tensorRight Δ[1])
  exact push.desc (bottomRangeHomotopy M h) 0 (by
    calc
      _ = 0 := bottomRangeHomotopy_zero_on_relativeIntersection M P A h hrel
      _ = _ ≫ 0 := by ext Delta x; rfl)

@[reassoc]
theorem literalConeRelativeBoundaryHomotopy_bottom
    (A : SimplicialObject AddCommGrpCat.{u})
    (h : orderedComplexSSet M ⊗ Δ[1] ⟶ underlyingSSet A)
    (hrel : P.ι ▷ Δ[1] ≫ h = 0) :
    SSet.Subcomplex.homOfLE
          (show literalConeBottomRange M ≤
              literalConeRelativeBoundarySubcomplex M P from le_sup_left) ▷
        Δ[1] ≫ literalConeRelativeBoundaryHomotopy M P A h hrel =
      bottomRangeHomotopy M h := by
  exact ((SSet.Subcomplex.BicartSq.isPushout
    (literalConeRelativeBoundaryBicartSq M P)).map
      (tensorRight Δ[1])).inl_desc _ _ _

@[reassoc]
theorem literalConeRelativeBoundaryHomotopy_baseLine
    (A : SimplicialObject AddCommGrpCat.{u})
    (h : orderedComplexSSet M ⊗ Δ[1] ⟶ underlyingSSet A)
    (hrel : P.ι ▷ Δ[1] ≫ h = 0) :
    SSet.Subcomplex.homOfLE
          (show literalConeRelativeBaseLineRange M P ≤
              literalConeRelativeBoundarySubcomplex M P from le_sup_right) ▷
        Δ[1] ≫ literalConeRelativeBoundaryHomotopy M P A h hrel = 0 := by
  exact ((SSet.Subcomplex.BicartSq.isPushout
    (literalConeRelativeBoundaryBicartSq M P)).map
      (tensorRight Δ[1])).inr_desc _ _ _

theorem literalConeRelativeBoundaryHomotopy_initial
    (A : SimplicialObject AddCommGrpCat.{u})
    (h : orderedComplexSSet M ⊗ Δ[1] ⟶ underlyingSSet A)
    (hrel : P.ι ▷ Δ[1] ≫ h = 0)
    (h₀ : SSet.ι₀ ≫ h = 0) :
    SSet.ι₀ ≫ literalConeRelativeBoundaryHomotopy M P A h hrel = 0 := by
  let push := SSet.Subcomplex.BicartSq.isPushout
    (literalConeRelativeBoundaryBicartSq M P)
  apply push.hom_ext
  · calc
      _ = SSet.ι₀ ≫
          (SSet.Subcomplex.homOfLE
            (show literalConeBottomRange M ≤
                literalConeRelativeBoundarySubcomplex M P from le_sup_left) ▷
              Δ[1]) ≫
          literalConeRelativeBoundaryHomotopy M P A h hrel := by
            rw [SSet.ι₀_comp_assoc]
      _ = SSet.ι₀ ≫ bottomRangeHomotopy M h := by
        rw [literalConeRelativeBoundaryHomotopy_bottom]
      _ = 0 := bottomRangeHomotopy_initial M A h h₀
      _ = _ ≫ 0 := by ext Delta x; rfl
  · calc
      _ = SSet.ι₀ ≫
          (SSet.Subcomplex.homOfLE
            (show literalConeRelativeBaseLineRange M P ≤
                literalConeRelativeBoundarySubcomplex M P from le_sup_right) ▷
              Δ[1]) ≫
          literalConeRelativeBoundaryHomotopy M P A h hrel := by
            rw [SSet.ι₀_comp_assoc]
      _ = SSet.ι₀ ≫ 0 := by
        rw [literalConeRelativeBoundaryHomotopy_baseLine]
      _ = 0 := by ext Delta x; rfl
      _ = _ ≫ 0 := by ext Delta x; rfl

theorem literalConeBottomMap_factor_relativeBoundary :
    SSet.Subcomplex.toRange (literalConeBottomMap M) ≫
        SSet.Subcomplex.homOfLE
          (show literalConeBottomRange M ≤
              literalConeRelativeBoundarySubcomplex M P from le_sup_left) ≫
        (literalConeRelativeBoundarySubcomplex M P).ι =
      literalConeBottomMap M := by
  simp only [Category.assoc, SSet.Subcomplex.homOfLE_ι,
    SSet.Subcomplex.toRange_ι]

theorem literalConeRelativeBaseLineMap_factor_boundary :
    SSet.Subcomplex.toRange (literalConeRelativeBaseLineMap M P) ≫
        SSet.Subcomplex.homOfLE
          (show literalConeRelativeBaseLineRange M P ≤
              literalConeRelativeBoundarySubcomplex M P from le_sup_right) ≫
        (literalConeRelativeBoundarySubcomplex M P).ι =
      literalConeRelativeBaseLineMap M P := by
  simp only [Category.assoc, SSet.Subcomplex.homOfLE_ι,
    SSet.Subcomplex.toRange_ι]

theorem literalConeRelativeBoundaryHomotopy_hep_initial
    (A : SimplicialObject AddCommGrpCat.{u})
    (h : orderedComplexSSet M ⊗ Δ[1] ⟶ underlyingSSet A)
    (hrel : P.ι ▷ Δ[1] ≫ h = 0)
    (h₀ : SSet.ι₀ ≫ h = 0) :
    (literalConeRelativeBoundarySubcomplex M P : SSet) ◁
          SSet.stdSimplex.δ (1 : Fin 2) ≫
        literalConeRelativeBoundaryHomotopy M P A h hrel = 0 := by
  rw [← boundaryTensorDeltaZeroMap_endpoint₀,
    literalConeRelativeBoundaryHomotopy_initial M P A h hrel h₀]
  ext Delta x
  rfl

theorem literalConeRelativeBoundaryHomotopy_terminal_bottom
    (A : SimplicialObject AddCommGrpCat.{u})
    (h : orderedComplexSSet M ⊗ Δ[1] ⟶ underlyingSSet A)
    (hrel : P.ι ▷ Δ[1] ≫ h = 0)
    (f : orderedComplexSSet M ⟶ underlyingSSet A)
    (h₁ : SSet.ι₁ ≫ h = f) :
    SSet.Subcomplex.toRange (literalConeBottomMap M) ▷ Δ[0] ≫
        (literalConeBottomRange M : SSet) ◁
          SSet.stdSimplex.δ (0 : Fin 2) ≫
        SSet.Subcomplex.homOfLE
          (show literalConeBottomRange M ≤
              literalConeRelativeBoundarySubcomplex M P from le_sup_left) ▷
            Δ[1] ≫
        literalConeRelativeBoundaryHomotopy M P A h hrel =
      boundaryTensorDeltaZeroMap f := by
  have hex :
      (SSet.Subcomplex.toRange (literalConeBottomMap M) ▷ Δ[0]) ≫
          (literalConeBottomRange M : SSet) ◁
            SSet.stdSimplex.δ (0 : Fin 2) =
        orderedComplexSSet M ◁ SSet.stdSimplex.δ (0 : Fin 2) ≫
          (SSet.Subcomplex.toRange (literalConeBottomMap M) ▷ Δ[1]) :=
    (whisker_exchange
      (SSet.Subcomplex.toRange (literalConeBottomMap M))
      (SSet.stdSimplex.δ (0 : Fin 2))).symm
  calc
    _ = orderedComplexSSet M ◁ SSet.stdSimplex.δ (0 : Fin 2) ≫
          (SSet.Subcomplex.toRange (literalConeBottomMap M) ▷ Δ[1]) ≫
          (SSet.Subcomplex.homOfLE
            (show literalConeBottomRange M ≤
                literalConeRelativeBoundarySubcomplex M P from le_sup_left) ▷
              Δ[1]) ≫
          literalConeRelativeBoundaryHomotopy M P A h hrel := by
      simp only [← Category.assoc]
      rw [hex]
    _ = orderedComplexSSet M ◁ SSet.stdSimplex.δ (0 : Fin 2) ≫ h := by
      rw [literalConeRelativeBoundaryHomotopy_bottom]
      rw [bottomRangeHomotopy]
      rw [← comp_whiskerRight_assoc,
        IsIso.hom_inv_id, id_whiskerRight, Category.id_comp]
    _ = boundaryTensorDeltaZeroMap (SSet.ι₁ ≫ h) :=
      (boundaryTensorDeltaZeroMap_endpoint₁ h).symm
    _ = boundaryTensorDeltaZeroMap f := by rw [h₁]

theorem literalConeRelativeBoundaryHomotopy_terminal_baseLine
    (A : SimplicialObject AddCommGrpCat.{u})
    (h : orderedComplexSSet M ⊗ Δ[1] ⟶ underlyingSSet A)
    (hrel : P.ι ▷ Δ[1] ≫ h = 0) :
    SSet.Subcomplex.toRange (literalConeRelativeBaseLineMap M P) ▷ Δ[0] ≫
        (literalConeRelativeBaseLineRange M P : SSet) ◁
          SSet.stdSimplex.δ (0 : Fin 2) ≫
        SSet.Subcomplex.homOfLE
          (show literalConeRelativeBaseLineRange M P ≤
              literalConeRelativeBoundarySubcomplex M P from le_sup_right) ▷
            Δ[1] ≫
        literalConeRelativeBoundaryHomotopy M P A h hrel = 0 := by
  rw [literalConeRelativeBoundaryHomotopy_baseLine]
  ext Delta x
  rfl

/-! ## The generic Kan--HEP assembly -/

open GeneralSphereT.Section4.NativeConeCriterionReverse

theorem nativeRelativeNullhomotopy_rel_eq_zero
    (A : SimplicialObject AddCommGrpCat.{u})
    {f : NativeRelativeMorphism P A}
    (H : SSet.RelativeMorphism.Homotopy
      (0 : NativeRelativeMorphism P A) f) :
    P.ι ▷ Δ[1] ≫ H.h = 0 := by
  calc
    _ = fst (P : SSet) Δ[1] ≫ zeroBoundary P A ≫
          (zeroSubcomplex A).ι := H.rel
    _ = 0 := cylinder_zeroBoundary P A

theorem nativeRelativeNullhomotopy_initial_eq_zero
    (A : SimplicialObject AddCommGrpCat.{u})
    {f : NativeRelativeMorphism P A}
    (H : SSet.RelativeMorphism.Homotopy
      (0 : NativeRelativeMorphism P A) f) :
    SSet.ι₀ ≫ H.h = 0 := by
  exact H.h₀.trans (relativeMorphism_zero_map P A)

noncomputable def nativeRelativeNullhomotopyBoundaryPath
    (A : SimplicialObject AddCommGrpCat.{u})
    {f : NativeRelativeMorphism P A}
    (H : SSet.RelativeMorphism.Homotopy
      (0 : NativeRelativeMorphism P A) f) :
    (literalConeRelativeBoundarySubcomplex M P : SSet) ⊗ Δ[1] ⟶
      underlyingSSet A :=
  literalConeRelativeBoundaryHomotopy M P A H.h
    (nativeRelativeNullhomotopy_rel_eq_zero M P A H)

theorem nativeRelativeNullhomotopyBoundaryPath_initial
    (A : SimplicialObject AddCommGrpCat.{u})
    {f : NativeRelativeMorphism P A}
    (H : SSet.RelativeMorphism.Homotopy
      (0 : NativeRelativeMorphism P A) f) :
    (literalConeRelativeBoundarySubcomplex M P).ι ▷ Δ[0] ≫
        tensorDeltaZeroMap
          (0 : orderedComplexSSet (simplicialCone M) ⟶ underlyingSSet A) =
      (literalConeRelativeBoundarySubcomplex M P : SSet) ◁
          SSet.stdSimplex.δ (1 : Fin 2) ≫
        nativeRelativeNullhomotopyBoundaryPath M P A H := by
  calc
    _ = 0 := by ext Delta z; rfl
    _ = _ := (literalConeRelativeBoundaryHomotopy_hep_initial
      M P A H.h (nativeRelativeNullhomotopy_rel_eq_zero M P A H)
      (nativeRelativeNullhomotopy_initial_eq_zero M P A H)).symm

/-- Lift the glued bottom/base-cone path along the generic mapping-space
restriction fibration and take its terminal endpoint. -/
noncomputable def nativeRelativeNullhomotopyExtendedTerminalMap
    (A : SimplicialObject AddCommGrpCat.{u})
    {f : NativeRelativeMorphism P A}
    (H : SSet.RelativeMorphism.Homotopy
      (0 : NativeRelativeMorphism P A) f) :
    orderedComplexSSet (simplicialCone M) ⊗ Δ[0] ⟶ underlyingSSet A :=
  extendedTerminalMap (literalConeRelativeBoundarySubcomplex M P).ι
    (underlyingSSet A)
    (tensorDeltaZeroMap
      (0 : orderedComplexSSet (simplicialCone M) ⟶ underlyingSSet A))
    (nativeRelativeNullhomotopyBoundaryPath M P A H)
    (nativeRelativeNullhomotopyBoundaryPath_initial M P A H)

theorem nativeRelativeNullhomotopyExtendedTerminalMap_boundary
    (A : SimplicialObject AddCommGrpCat.{u})
    {f : NativeRelativeMorphism P A}
    (H : SSet.RelativeMorphism.Homotopy
      (0 : NativeRelativeMorphism P A) f) :
    (literalConeRelativeBoundarySubcomplex M P).ι ▷ Δ[0] ≫
        nativeRelativeNullhomotopyExtendedTerminalMap M P A H =
      (literalConeRelativeBoundarySubcomplex M P : SSet) ◁
          SSet.stdSimplex.δ (0 : Fin 2) ≫
        nativeRelativeNullhomotopyBoundaryPath M P A H := by
  exact extendedTerminalMap_restricts
    (literalConeRelativeBoundarySubcomplex M P).ι (underlyingSSet A)
    (tensorDeltaZeroMap
      (0 : orderedComplexSSet (simplicialCone M) ⟶ underlyingSSet A))
    (nativeRelativeNullhomotopyBoundaryPath M P A H)
    (nativeRelativeNullhomotopyBoundaryPath_initial M P A H)

theorem nativeRelativeNullhomotopyExtendedTerminalMap_bottom
    (A : SimplicialObject AddCommGrpCat.{u})
    {f : NativeRelativeMorphism P A}
    (H : SSet.RelativeMorphism.Homotopy
      (0 : NativeRelativeMorphism P A) f) :
    literalConeBottomMap M ▷ Δ[0] ≫
        nativeRelativeNullhomotopyExtendedTerminalMap M P A H =
      tensorDeltaZeroMap f.map := by
  let j := SSet.Subcomplex.homOfLE
    (show literalConeBottomRange M ≤
        literalConeRelativeBoundarySubcomplex M P from le_sup_left)
  have hfactor := congrArg (fun k ↦ k ▷ Δ[0])
    (literalConeBottomMap_factor_relativeBoundary M P)
  have hex :
      j ▷ Δ[0] ≫
          (literalConeRelativeBoundarySubcomplex M P : SSet) ◁
            SSet.stdSimplex.δ (0 : Fin 2) =
        (literalConeBottomRange M : SSet) ◁
            SSet.stdSimplex.δ (0 : Fin 2) ≫ j ▷ Δ[1] :=
    whisker_exchange j (SSet.stdSimplex.δ (0 : Fin 2))
  calc
    literalConeBottomMap M ▷ Δ[0] ≫
          nativeRelativeNullhomotopyExtendedTerminalMap M P A H =
        (SSet.Subcomplex.toRange (literalConeBottomMap M) ▷ Δ[0]) ≫
          (j ▷ Δ[0]) ≫
          ((literalConeRelativeBoundarySubcomplex M P).ι ▷ Δ[0]) ≫
          nativeRelativeNullhomotopyExtendedTerminalMap M P A H := by
      rw [← hfactor]
      simp only [comp_whiskerRight, Category.assoc, j]
    _ = (SSet.Subcomplex.toRange (literalConeBottomMap M) ▷ Δ[0]) ≫
          (j ▷ Δ[0]) ≫
          ((literalConeRelativeBoundarySubcomplex M P : SSet) ◁
            SSet.stdSimplex.δ (0 : Fin 2)) ≫
          nativeRelativeNullhomotopyBoundaryPath M P A H := by
      rw [nativeRelativeNullhomotopyExtendedTerminalMap_boundary]
    _ = (SSet.Subcomplex.toRange (literalConeBottomMap M) ▷ Δ[0]) ≫
          ((literalConeBottomRange M : SSet) ◁
            SSet.stdSimplex.δ (0 : Fin 2)) ≫
          (j ▷ Δ[1]) ≫
          nativeRelativeNullhomotopyBoundaryPath M P A H := by
      rw [← Category.assoc (j ▷ Δ[0])
        ((literalConeRelativeBoundarySubcomplex M P : SSet) ◁
          SSet.stdSimplex.δ (0 : Fin 2))
        (nativeRelativeNullhomotopyBoundaryPath M P A H), hex]
      simp only [Category.assoc]
    _ = boundaryTensorDeltaZeroMap f.map := by
      exact literalConeRelativeBoundaryHomotopy_terminal_bottom
        M P A H.h (nativeRelativeNullhomotopy_rel_eq_zero M P A H)
        f.map H.h₁
    _ = tensorDeltaZeroMap f.map := rfl

theorem nativeRelativeNullhomotopyExtendedTerminalMap_baseLine
    (A : SimplicialObject AddCommGrpCat.{u})
    {f : NativeRelativeMorphism P A}
    (H : SSet.RelativeMorphism.Homotopy
      (0 : NativeRelativeMorphism P A) f) :
    literalConeRelativeBaseLineMap M P ▷ Δ[0] ≫
        nativeRelativeNullhomotopyExtendedTerminalMap M P A H = 0 := by
  let j := SSet.Subcomplex.homOfLE
    (show literalConeRelativeBaseLineRange M P ≤
        literalConeRelativeBoundarySubcomplex M P from le_sup_right)
  have hfactor := congrArg (fun k ↦ k ▷ Δ[0])
    (literalConeRelativeBaseLineMap_factor_boundary M P)
  have hex :
      j ▷ Δ[0] ≫
          (literalConeRelativeBoundarySubcomplex M P : SSet) ◁
            SSet.stdSimplex.δ (0 : Fin 2) =
        (literalConeRelativeBaseLineRange M P : SSet) ◁
            SSet.stdSimplex.δ (0 : Fin 2) ≫ j ▷ Δ[1] :=
    whisker_exchange j (SSet.stdSimplex.δ (0 : Fin 2))
  calc
    literalConeRelativeBaseLineMap M P ▷ Δ[0] ≫
          nativeRelativeNullhomotopyExtendedTerminalMap M P A H =
        (SSet.Subcomplex.toRange
            (literalConeRelativeBaseLineMap M P) ▷ Δ[0]) ≫
          (j ▷ Δ[0]) ≫
          ((literalConeRelativeBoundarySubcomplex M P).ι ▷ Δ[0]) ≫
          nativeRelativeNullhomotopyExtendedTerminalMap M P A H := by
      rw [← hfactor]
      simp only [comp_whiskerRight, Category.assoc, j]
    _ = (SSet.Subcomplex.toRange
            (literalConeRelativeBaseLineMap M P) ▷ Δ[0]) ≫
          (j ▷ Δ[0]) ≫
          ((literalConeRelativeBoundarySubcomplex M P : SSet) ◁
            SSet.stdSimplex.δ (0 : Fin 2)) ≫
          nativeRelativeNullhomotopyBoundaryPath M P A H := by
      rw [nativeRelativeNullhomotopyExtendedTerminalMap_boundary]
    _ = (SSet.Subcomplex.toRange
            (literalConeRelativeBaseLineMap M P) ▷ Δ[0]) ≫
          ((literalConeRelativeBaseLineRange M P : SSet) ◁
            SSet.stdSimplex.δ (0 : Fin 2)) ≫
          (j ▷ Δ[1]) ≫
          nativeRelativeNullhomotopyBoundaryPath M P A H := by
      rw [← Category.assoc (j ▷ Δ[0])
        ((literalConeRelativeBoundarySubcomplex M P : SSet) ◁
          SSet.stdSimplex.δ (0 : Fin 2))
        (nativeRelativeNullhomotopyBoundaryPath M P A H), hex]
      simp only [Category.assoc]
    _ = 0 := literalConeRelativeBoundaryHomotopy_terminal_baseLine
      M P A H.h (nativeRelativeNullhomotopy_rel_eq_zero M P A H)

theorem literalConeRelativeBaseLineMap_eq_quotient :
    P.ι ▷ Δ[1] ≫ literalConeCylinderQuotient M =
      literalConeRelativeBaseLineMap M P := by
  rw [literalConeCylinderQuotient_eq,
    literalConeRelativeBaseLineMap, comp_whiskerRight_assoc]

theorem literalConeApex_comp_eq_zero_of_relativeBaseLine
    (p : (P : SSet).obj (Opposite.op (SimplexCategory.mk 0)))
    (A : SimplicialObject AddCommGrpCat.{u})
    (g : orderedComplexSSet (simplicialCone M) ⟶ underlyingSSet A)
    (hbase : literalConeRelativeBaseLineMap M P ≫ g = 0) :
    SSet.const
        (X := orderedComplexSSet M)
        (literalConeApex M) ≫ g = 0 := by
  have hconstP :
      SSet.const (X := (P : SSet)) (literalConeApex M) ≫ g = 0 := by
    rw [← ι₀_literalConeRelativeBaseLineMap M P,
      Category.assoc, hbase]
    ext Delta z
    rfl
  have hapex :
      g.app (Opposite.op (SimplexCategory.mk 0)) (literalConeApex M) = 0 := by
    exact ConcreteCategory.congr_hom
      (congr_app hconstP (Opposite.op (SimplexCategory.mk 0))) p
  rw [SSet.const_comp, hapex]
  exact const_zeroVertex_eq_zeroMap
    (X := orderedComplexSSet M) A

/-- Final assembly of the HEP endpoint as a literal extension relative to
the whole subcomplex `P`. -/
def literalRelativeExtensionOfTensorDeltaZeroMap
    (p : (P : SSet).obj (Opposite.op (SimplexCategory.mk 0)))
    (A : SimplicialObject AddCommGrpCat.{u})
    (f : NativeRelativeMorphism P A)
    (g : orderedComplexSSet (simplicialCone M) ⊗ Δ[0] ⟶ underlyingSSet A)
    (hbottom : literalConeBottomMap M ▷ Δ[0] ≫ g =
      tensorDeltaZeroMap f.map)
    (hbase : literalConeRelativeBaseLineMap M P ▷ Δ[0] ≫ g = 0) :
    LiteralRelativeExtension M P A f where
  map := untensorDeltaZeroMap g
  bottom := by
    rw [untensorDeltaZeroMap_restricts
      (literalConeBottomMap M) g (tensorDeltaZeroMap f.map) hbottom,
      untensor_tensorDeltaZeroMap]
  apex := literalConeApex_comp_eq_zero_of_relativeBaseLine M P p A
    (untensorDeltaZeroMap g) (by
      rw [untensorDeltaZeroMap, ← Category.assoc,
        ← whiskerRight_deltaZero_section, Category.assoc, hbase]
      ext Delta z
      rfl)
  rel := by
    calc
      P.ι ▷ Δ[1] ≫ literalConeCylinderQuotient M ≫
          untensorDeltaZeroMap g =
        literalConeRelativeBaseLineMap M P ≫
          untensorDeltaZeroMap g := by
            rw [← Category.assoc,
              literalConeRelativeBaseLineMap_eq_quotient M P]
      _ = 0 := by
        rw [untensorDeltaZeroMap, ← Category.assoc,
          ← whiskerRight_deltaZero_section, Category.assoc, hbase]
        ext Delta z
        rfl
      _ = fst (P : SSet) Δ[1] ≫ zeroBoundary P A ≫
          (zeroSubcomplex A).ι := (cylinder_zeroBoundary P A).symm

/-- An arbitrary native relative nullhomotopy gives an actual extension
over the literal cone, zero on the cone over the entire relative boundary. -/
noncomputable def literalRelativeExtensionOfNativeNullhomotopy
    (p : (P : SSet).obj (Opposite.op (SimplexCategory.mk 0)))
    (A : SimplicialObject AddCommGrpCat.{u})
    {f : NativeRelativeMorphism P A}
    (H : SSet.RelativeMorphism.Homotopy
      (0 : NativeRelativeMorphism P A) f) :
    LiteralRelativeExtension M P A f :=
  literalRelativeExtensionOfTensorDeltaZeroMap M P p A f
    (nativeRelativeNullhomotopyExtendedTerminalMap M P A H)
    (nativeRelativeNullhomotopyExtendedTerminalMap_bottom M P A H)
    (nativeRelativeNullhomotopyExtendedTerminalMap_baseLine M P A H)

/-- Class-zero native relative maps admit literal relative extensions as
soon as the boundary subcomplex contains a chosen vertex. -/
theorem nonempty_literalRelativeExtension_of_mem_nativeNullMaps
    (p : (P : SSet).obj (Opposite.op (SimplexCategory.mk 0)))
    (A : SimplicialObject AddCommGrpCat.{u})
    (f : NativeRelativeMorphism P A)
    (hf : f ∈ NativeNullMaps P A) :
    Nonempty (LiteralRelativeExtension M P A f) := by
  have hfzero : f.homotopyClass = 0 := LinearMap.mem_ker.mp hf
  have hzero : (0 : NativeRelativeMorphism P A).homotopyClass = 0 :=
    homotopyClass_zero P A
  have hclass :
      (0 : NativeRelativeMorphism P A).homotopyClass = f.homotopyClass :=
    hzero.trans hfzero.symm
  rcases (homotopyClass_eq_iff P A).mp hclass with ⟨H⟩
  exact ⟨literalRelativeExtensionOfNativeNullhomotopy M P p A H⟩

