import Formalization.OpenDisk.WordOperators
import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.Algebra.Group.Submonoid.Membership

/-!
# Diagonal operators in an actual hopping algebra

The algebra is generated by literal hopping operators, with actual inverse
letters supplied by `signedSteps`. Its diagonal part is spanned by closed
words. This is a matrix-entry statement, not an assertion modulo phases or
only after restriction to an invariant subspace.
-/

noncomputable section
set_option maxHeartbeats 800000

namespace OpenDisk
variable {C E : Type*} [AddCommGroup C]

abbrev CoefficientEnd (C : Type*) := Module.End ℂ (C → ℂ)

def signedSteps (steps : E → HoppingStep C) : E ⊕ E → HoppingStep C :=
  Sum.elim steps (fun e => inverseHoppingStep (steps e))

def wordEnd (steps : E → HoppingStep C) (word : List E) : CoefficientEnd C :=
  (hoppingWordEquiv (word.map steps)).toLinearMap

def hoppingAlgebra (steps : E → HoppingStep C) : Subalgebra ℂ (CoefficientEnd C) :=
  Algebra.adjoin ℂ (Set.range (fun e => (hoppingEquiv (steps e).1 (steps e).2).toLinearMap))

/-- Algebra containing the specified operators and their actual inverses. -/
def actualHoppingAlgebra (steps : E → HoppingStep C) : Subalgebra ℂ (CoefficientEnd C) :=
  hoppingAlgebra (signedSteps steps)

theorem wordEnd_append (steps : E → HoppingStep C) (xs ys : List E) :
    wordEnd steps (xs ++ ys) = wordEnd steps ys * wordEnd steps xs := by
  simp only [wordEnd, List.map_append, hoppingWordEquiv_append]
  rfl

/-- The diagonal projection reads the actual diagonal matrix entries. -/
def diagonalPart : CoefficientEnd C →ₗ[ℂ] CoefficientEnd C := by
  classical
  refine
    { toFun := fun A =>
        { toFun := fun ψ v => A (Pi.single v 1) v * ψ v
          map_add' := by intro ψ χ; funext v; exact mul_add _ _ _
          map_smul' := by intro k ψ; funext v; change _ * (k * _) = k * (_ * _); ring }
      map_add' := ?_
      map_smul' := ?_ }
  · intro A B; ext ψ v
    change (A (Pi.single v 1) v + B (Pi.single v 1) v) * ψ v =
      A (Pi.single v 1) v * ψ v + B (Pi.single v 1) v * ψ v
    exact add_mul _ _ _
  · intro k A; ext ψ v
    change (k * A (Pi.single v 1) v) * ψ v = k * (A (Pi.single v 1) v * ψ v)
    ring

@[simp] theorem diagonalPart_diagonal (κ : C → CirclePhase) :
    diagonalPart (diagonalEquiv κ).toLinearMap = (diagonalEquiv κ).toLinearMap := by
  classical
  ext ψ v
  simp [diagonalPart, diagonalEquiv_apply]

theorem diagonalPart_hopping_of_ne (L : C → CirclePhase) (s : C) (hs : s ≠ 0) :
    diagonalPart (hoppingEquiv L s).toLinearMap = 0 := by
  classical
  ext ψ v
  have hv : v - s ≠ v := by
    intro h
    apply hs
    exact (sub_eq_self.mp h)
  simp [diagonalPart, hoppingEquiv_apply, Pi.single_apply, hv, hs]

def closedWordSpan (steps : E → HoppingStep C) : Submodule ℂ (CoefficientEnd C) :=
  Submodule.span ℂ {A | ∃ word : List E,
    hoppingWordIncrement (word.map steps) = 0 ∧ wordEnd steps word = A}

theorem monomial_is_word (steps : E → HoppingStep C) (A : CoefficientEnd C)
    (hA : A ∈ Submonoid.closure
      (Set.range (fun e => (hoppingEquiv (steps e).1 (steps e).2).toLinearMap))) :
    ∃ word : List E, wordEnd steps word = A := by
  induction hA using Submonoid.closure_induction with
  | mem A hA =>
      obtain ⟨e, rfl⟩ := hA
      exact ⟨[e], rfl⟩
  | one => exact ⟨[], rfl⟩
  | mul A B hA hB ihA ihB =>
      obtain ⟨xs, rfl⟩ := ihA
      obtain ⟨ys, rfl⟩ := ihB
      exact ⟨ys ++ xs, wordEnd_append steps ys xs⟩

theorem diagonalPart_word_mem (steps : E → HoppingStep C) (word : List E) :
    diagonalPart (wordEnd steps word) ∈ closedWordSpan steps := by
  classical
  by_cases h : hoppingWordIncrement (word.map steps) = 0
  · have hw : wordEnd steps word = (diagonalEquiv (hoppingWordPhase (word.map steps))).toLinearMap := by
      ext ψ v
      exact congrFun (hoppingWord_closed _ h ψ) v
    rw [hw, diagonalPart_diagonal, ← hw]
    exact Submodule.subset_span ⟨word, h, rfl⟩
  · have hz : diagonalPart (wordEnd steps word) = 0 := by
      rw [wordEnd, hoppingWordEquiv_eq]
      exact diagonalPart_hopping_of_ne _ _ h
    rw [hz]
    exact (closedWordSpan steps).zero_mem

/-- Deleting all nonclosed word terms is justified by their zero diagonal entries. -/
theorem diagonalPart_mem_closedWordSpan (steps : E → HoppingStep C) (A : CoefficientEnd C)
    (hA : A ∈ hoppingAlgebra steps) : diagonalPart A ∈ closedWordSpan steps := by
  change A ∈ (Algebra.adjoin ℂ _).toSubmodule at hA
  rw [Algebra.adjoin_eq_span] at hA
  induction hA using Submodule.span_induction with
  | mem A hA =>
      obtain ⟨word, rfl⟩ := monomial_is_word steps A hA
      exact diagonalPart_word_mem steps word
  | zero => simpa using (closedWordSpan steps).zero_mem
  | add A B hA hB ihA ihB =>
      simpa only [map_add] using (closedWordSpan steps).add_mem ihA ihB
  | smul k A hA ihA =>
      simpa only [map_smul] using (closedWordSpan steps).smul_mem k ihA

/-- Every diagonal in the literal regional algebra is a linear combination of closed words. -/
theorem diagonal_mem_closedWordSpan (steps : E → HoppingStep C) (A : CoefficientEnd C)
    (hA : A ∈ hoppingAlgebra steps) (hdiag : diagonalPart A = A) :
    A ∈ closedWordSpan steps := by
  rw [← hdiag]
  exact diagonalPart_mem_closedWordSpan steps A hA

end OpenDisk
