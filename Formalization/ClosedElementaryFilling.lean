import Formalization.OrderedFilling
import Formalization.OrderedFillingNaturality
import Formalization.ElementaryPaths
import Formalization.Subdivision

set_option linter.style.header false

/-!
# Boundary-level filling of closed elementary paths

This is the linear path-level content of equation (2.31).  It does not define
a type of primitive two-chains or a chain-level filling operator.  It proves
only that the comparison path lies in the span of the specified square
and triangle boundaries.
-/

noncomputable section

namespace GeneralSphereT.PathAlgebra

variable {ι G : Type*} [LinearOrder ι] [AddCommGroup G]

/--
Boundary-level form of (2.31): an elementary primitive path differs from the
canonical ordered path of its reduced boundary by a sum of primitive square
and triangle boundaries.

On one elementary edge this is exactly `elementary_edge_ordered_loop_mem`;
linearity then extends the statement to the whole elementary span.
-/
theorem sub_canonicalPath_primitiveReducedBoundary_mem_primitiveCellBoundaries
    {p : Path (Configuration ι G) (Configuration ι G)}
    (hp : p ∈ elementaryPaths
      (ι := ι) (G := G) (X := Configuration ι G)) :
    p - canonicalPath
        (primitiveReducedBoundary (Configuration ι G) p) ∈
      primitiveCellBoundaries (ι := ι) (G := G) := by
  change p ∈ Submodule.span ℤ
    {q | ∃ (i : ι) (g : G) (c : Configuration ι G),
      g ≠ 0 ∧ q = edge (Finsupp.single i g) c} at hp
  induction hp using Submodule.span_induction with
  | mem p hp =>
      rcases hp with ⟨i, g, c, hg, rfl⟩
      have hloop := elementary_edge_ordered_loop_mem c i g
      simp only [reducedBoundary_edge, AddMonoidHom.id_apply, map_sub,
        canonicalPath_redBracket]
      have heq :
          edge (Finsupp.single i g) c -
              (orderedPath (c + Finsupp.single i g) 0 - orderedPath c 0) =
            orderedPath c 0 + edge (Finsupp.single i g) c -
              orderedPath (c + Finsupp.single i g) 0 := by
        abel
      rw [heq]
      exact hloop
  | zero => simp
  | add p q hp hq ihp ihq =>
      simp only [map_add, add_sub_add_comm]
      exact (primitiveCellBoundaries (ι := ι) (G := G)).add_mem ihp ihq
  | smul n p hp ih =>
      simp only [map_smul]
      rw [← smul_sub]
      exact (primitiveCellBoundaries (ι := ι) (G := G)).smul_mem n ih

/--
In particular, every closed elementary primitive path is generated by the
chosen primitive square and triangle boundaries.
-/
theorem closedElementaryPath_mem_primitiveCellBoundaries
    {p : Path (Configuration ι G) (Configuration ι G)}
    (helem : p ∈ elementaryPaths
      (ι := ι) (G := G) (X := Configuration ι G))
    (hclosed : primitiveReducedBoundary (Configuration ι G) p = 0) :
    p ∈ primitiveCellBoundaries (ι := ι) (G := G) := by
  simpa [hclosed] using
    sub_canonicalPath_primitiveReducedBoundary_mem_primitiveCellBoundaries
      helem

/--
Coordinate restriction preserves the boundary-level conclusion for a closed
elementary path.  This uses the previously verified stability of the cell
boundary span; it is not a claim about a chain-level filling operator.
-/
theorem mapPath_coordinateRestriction_closedElementaryPath_mem_primitiveCellBoundaries
    (S : Set ι)
    {p : Path (Configuration ι G) (Configuration ι G)}
    (helem : p ∈ elementaryPaths
      (ι := ι) (G := G) (X := Configuration ι G))
    (hclosed : primitiveReducedBoundary (Configuration ι G) p = 0) :
    mapPath (coordinateRestriction S) (coordinateRestriction S) p ∈
      primitiveCellBoundaries (ι := S) (G := G) := by
  exact mapPath_coordinateRestriction_primitiveCellBoundaries_mem S
    (closedElementaryPath_mem_primitiveCellBoundaries helem hclosed)

end GeneralSphereT.PathAlgebra
