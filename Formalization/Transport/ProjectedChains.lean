import Formalization.Transport.RelativeEvaluation
import Formalization.Transport.EMIntegralCycles
import Mathlib.AlgebraicTopology.DoldKan.Degeneracies

/-! Projection from actual simplex distributions to reduced Moore chains.
In positive degree its kernel is generated by the degenerate simplices. -/
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
set_option maxHeartbeats 1200000
noncomputable section
open CategoryTheory Opposite Simplicial AlgebraicTopology AlgebraicTopology.DoldKan
namespace GeneralSphereT.Transport.Prism
open GeneralSphereT.PathAlgebra GeneralSphereT.StandardModels OpenDisk.PhaseDuality RelativeChains
variable {U : Type} [AddCommGroup U]

def reduceDist : Distribution U →ₗ[ℤ] RedDist U := Finsupp.linearCombination ℤ redBracket

theorem reduceDist_val (z : Distribution U) :
    (reduceDist z).val=z-Finsupp.single 0 (augmentation U z) := by
  have eq : (RedDist U).subtype.comp reduceDist=LinearMap.id-(Finsupp.lsingle (R:=ℤ) (M:=ℤ) (0:U)).comp (augmentation U) := by
    ext a b
    simp [reduceDist,redBracket,bracket,augmentation]
  exact LinearMap.congr_fun eq z

theorem reduceDist_red (z : RedDist U) : reduceDist z.val=z := by
  apply Subtype.ext
  simp only [reduceDist_val,show augmentation U z.val=0 from z.property,Finsupp.single_zero,sub_zero]

variable (A : SimplicialObject AddCommGrpCat.{0})

def mooreProjection (n : ℕ) := ((PInftyToNormalizedMooreComplex (reducedFree A)).f n).hom.toIntLinearMap
def mooreInclusion (n : ℕ) := ((inclusionOfMooreComplexMap (reducedFree A)).f n).hom.toIntLinearMap

def simplexProjection (n : ℕ) : Distribution (A _⦋n⦌) →ₗ[ℤ] (Moore.obj (reducedFree A)).X n :=
  (mooreProjection A n).comp reduceDist

theorem project_include (n : ℕ) (z : (Moore.obj (reducedFree A)).X n) :
    simplexProjection A n (mooreInclusion A n z).val=z := by
  change mooreProjection A n (reduceDist (mooreInclusion A n z).val)=z
  rw [reduceDist_red (mooreInclusion A n z)]
  exact ConcreteCategory.congr_hom (HomologicalComplex.congr_hom (splitMonoInclusionOfMooreComplexMap (reducedFree A)).id n) z

def degenerateSpan (n : ℕ) : Submodule ℤ (Distribution (A _⦋n+1⦌)) :=
  Submodule.span ℤ {x | ∃ (i : Fin (n+1)) (a : A _⦋n⦌), x=Finsupp.single (A.σ i a) 1}

theorem project_degenerate (n : ℕ) (i : Fin (n+1)) (a : A _⦋n⦌) :
    simplexProjection A (n+1) (Finsupp.single (A.σ i a) 1)=0 := by
  have H : (reducedFree A).σ i ≫ (PInftyToNormalizedMooreComplex (reducedFree A)).f (n+1)=0 := by
    apply (cancel_mono ((inclusionOfMooreComplexMap (reducedFree A)).f (n+1))).mp
    rw [Category.assoc,← HomologicalComplex.comp_f,PInftyToNormalizedMooreComplex_comp_inclusionOfMooreComplexMap,σ_comp_PInfty,Limits.zero_comp]
  change mooreProjection A (n+1) (reduceDist (Finsupp.single (A.σ i a) 1))=0
  rw [show reduceDist (Finsupp.single (A.σ i a) 1)=redBracket (A.σ i a) by simp [reduceDist]]
  have ha : (reducedFree A).σ i (redBracket a) = redBracket (A.σ i a) := mapRedDist_redBracket _ a
  exact (congrArg (mooreProjection A (n+1)) ha.symm).trans (ConcreteCategory.congr_hom H (redBracket a))

theorem project_kills_degeneracies (n : ℕ) : degenerateSpan A n ≤ LinearMap.ker (simplexProjection A (n+1)) := by
  apply Submodule.span_le.mpr
  rintro _ ⟨i,a,rfl⟩
  exact project_degenerate A n i a

/-- A functional which kills every degeneracy already factors through the
projection onto Moore chains. -/
theorem through_moore {T : AddCommGrpCat.{0}} {n : ℕ} (h : (reducedFree A).obj (op ⦋n⦌) ⟶ T)
    (hh : DegeneraciesVanish (X:=reducedFree A) h) (z : RedDist (A _⦋n⦌)) :
    h (mooreInclusion A n (mooreProjection A n z))=h z := by
  have hQ := (degeneraciesVanish_iff_QInfty_f_comp h).mp hh
  have he := congrArg (fun f : (reducedFree A).obj (op ⦋n⦌) ⟶ _ => f ≫ h) (PInfty_f_add_QInfty_f (X:=reducedFree A) n)
  rw [Preadditive.add_comp,hQ,add_zero] at he
  have hp := HomologicalComplex.congr_hom (PInftyToNormalizedMooreComplex_comp_inclusionOfMooreComplexMap (reducedFree A)) n
  exact (congrArg h (ConcreteCategory.congr_hom hp z)).trans (ConcreteCategory.congr_hom he z)

private theorem quotient_deg (n : ℕ) (i : Fin (n+1)) (a : A _⦋n⦌) :
    (degenerateSpan A n).mkQ (Finsupp.single (A.σ i a) 1)=0 :=
  (Submodule.Quotient.mk_eq_zero _).mpr (Submodule.subset_span ⟨i,a,rfl⟩)

private theorem quotient_zero_simplex (n : ℕ) (k : ℤ) :
    (degenerateSpan A n).mkQ (Finsupp.single (0 : A _⦋n+1⦌) k)=0 := by
  have h := quotient_deg A n (0 : Fin (n+1)) 0
  rw [map_zero] at h
  rw [show Finsupp.single (0 : A _⦋n+1⦌) k=k • Finsupp.single 0 1 by simp,map_smul,h,smul_zero]

theorem class_of_projection (n : ℕ) (z : Distribution (A _⦋n+1⦌)) :
    (degenerateSpan A n).mkQ (mooreInclusion A (n+1) (simplexProjection A (n+1) z)).val=(degenerateSpan A n).mkQ z := by
  let Q := (degenerateSpan A n).mkQ
  let χ := Q.comp (RedDist (A _⦋n+1⦌)).subtype
  let t : (reducedFree A).obj (op ⦋n+1⦌) ⟶ AddCommGrpCat.of (Distribution (A _⦋n+1⦌) ⧸ degenerateSpan A n) :=
    AddCommGrpCat.ofHom χ.toAddMonoidHom
  have v : DegeneraciesVanish (X:=reducedFree A) t := by
    intro i
    apply AddCommGrpCat.ext
    intro a
    change Q (mapDistFn (A.σ i) a.val)=0
    have h : Q.comp (mapDistFn (A.σ i))=0 := by
      apply Finsupp.lhom_ext'
      intro b
      apply LinearMap.ext_ring
      exact ((congrArg Q (mapDistFn_single (A.σ i) b 1)).trans (quotient_deg A n i b))
    exact LinearMap.congr_fun h a.val
  have eq := through_moore A t v (reduceDist z)
  change Q _=Q (reduceDist z).val at eq
  exact eq.trans (by rw [reduceDist_val,map_sub,quotient_zero_simplex,sub_zero])

theorem kernel_projection (n : ℕ) : LinearMap.ker (simplexProjection A (n+1))=degenerateSpan A n := by
  apply le_antisymm _ (project_kills_degeneracies A n)
  intro z hz
  apply (Submodule.Quotient.mk_eq_zero _).mp
  change (degenerateSpan A n).mkQ z=0
  rw [← class_of_projection A n z,show simplexProjection A (n+1) z=0 from hz,map_zero,Submodule.coe_zero,map_zero]

end GeneralSphereT.Transport.Prism

