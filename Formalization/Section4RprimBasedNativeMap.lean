import Formalization.Section4GlobalBasepointEvaluation
import Formalization.Section4NativePointedMappingSpace

set_option linter.style.header false
set_option backward.isDefEq.respectTransparency false

/-!
# Section 4: based primitive relations as genuine pointed fibre maps

This is the native form of the middle arrow in (4.3).  A primitive relation
whose singleton-facet value is zero evaluates to an actual map into `F`, and
the basepoint calculation shows that this map is strictly pointed on the
entire simplicial subcomplex generated by the chosen vertex.
-/

noncomputable section

open CategoryTheory CategoryTheory.Category Opposite Simplicial

namespace GeneralSphereT.SimplicialCochain

open GeneralSphereT.PathAlgebra
open GeneralSphereT.PathAlgebra.FacetRestrictionData
open GeneralSphereT.StandardModels
open GeneralSphereT.Section4
open GeneralSphereT.Section4.RelativeMapping
open GeneralSphereT.Section4.NativeRelativeHomotopyGroup

universe u

variable {V G : Type u} [LinearOrder V] [Fintype V] [AddCommGroup G]

/-- The based primitive-relation group in the concrete row (4.3). -/
private abbrev BasedRprim
    (M : AbstractSimplicialComplex V) (b : V) (q : ℕ) :=
  LinearMap.ker
    (evalRprim (facetRestrictionData (G := G) M q)
      (basepointFacet M b))

/-- Genuine pointed `F`-valued evaluation of a based primitive relation. -/
def basedRprimToNativePointedMap
    (M : AbstractSimplicialComplex V) (b : V) (q : ℕ) :
    BasedRprim (G := G) M b q →ₗ[ℤ]
      NativePointedMaps M b (AddCommGrpCat.of G) (q + 1) where
  toFun r :=
    { map := rprimToNativeFiberMap M q r.1
      comm := by
        rw [zeroBoundary_comp_inclusion]
        exact (rprimToNativeFiberMap_basepoint_eq_zero_iff M b q r.1).2 r.2 }
  map_add' r s := by
    apply SSet.RelativeMorphism.ext
    exact map_add (rprimToNativeFiberMap M q) r.1 s.1
  map_smul' n r := by
    apply SSet.RelativeMorphism.ext
    exact map_smul (rprimToNativeFiberMap M q) n r.1

@[simp]
theorem basedRprimToNativePointedMap_map
    (M : AbstractSimplicialComplex V) (b : V) (q : ℕ)
    (r : BasedRprim (G := G) M b q) :
    (basedRprimToNativePointedMap M b q r).map =
      rprimToNativeFiberMap M q r.1 :=
  rfl

/-- After the fibre inclusion, the pointed map is the genuine global
cochain-distribution restriction map. -/
theorem basedRprimToNativePointedMap_comp_inclusion
    (M : AbstractSimplicialComplex V) (b : V) (q : ℕ)
    (r : BasedRprim (G := G) M b q) :
    (basedRprimToNativePointedMap M b q r).map ≫
        underlyingMap (Fι (AddCommGrpCat.of G) (q + 1)) =
      globalCochainRestrictionMap M q
        (r.1 : RedDist (Cochain M q G)) :=
  rprimToNativeFiberMap_comp_inclusion M q r.1

/-- Primitive cycles map to the strict zero pointed map, before quotienting
by pointed homotopy. -/
theorem basedRprimToNativePointedMap_cycles_eq_zero
    (M : AbstractSimplicialComplex V) (b : V) (q : ℕ)
    (z : Zprim (facetRestrictionData (G := G) M q)) :
    basedRprimToNativePointedMap M b q
        ((simplicialBasepointRowData (G := G) M b q).cyclesToBasedRelations z) =
      0 := by
  apply SSet.RelativeMorphism.ext
  change rprimToNativeFiberMap M q
      (zprimToRprim (facetRestrictionData (G := G) M q) z) = 0
  exact zprimToRprim_nativeFiberMap_eq_zero M q z

end GeneralSphereT.SimplicialCochain
