import Formalization.Section4OrderedComplexSSet
import Formalization.Section4ReducedFreeFiber
import Formalization.Section4NativeRelativeHomotopyGroup
import Formalization.Section4NativeDoubleCone

set_option linter.style.header false

/-!
# Section 4: the actual pointed mapping group into `F(G,q)`

This file specializes Mathlib's native relative-morphism and relative-homotopy
types to the ordered simplicial complex used in the paper.  The source
subcomplex is generated by the chosen vertex, and the target is the literal
Dold--Kan fibre `F(G,q)`.  Thus the notation below is an actual simplicial
mapping-class group, not an abstract quotient standing in for one.
-/

noncomputable section

namespace GeneralSphereT.Section4

open GeneralSphereT.SimplicialCochain
open GeneralSphereT.StandardModels
open NativeRelativeHomotopyGroup
open NativeDoubleCone

universe u

variable {V : Type u} [LinearOrder V]

/-- Genuine pointed simplicial maps from an ordered complex to the standard
fibre `F(G,q)`. -/
abbrev NativePointedMaps
    (M : AbstractSimplicialComplex V) (b : V)
    (G : AddCommGrpCat.{u}) (q : ℕ) :=
  NativeRelativeMorphism
    (orderedComplexBasepointSubcomplex M b) (F G q)

/-- Genuine pointed simplicial homotopy classes with their pointwise
abelian-group structure. -/
abbrev NativePointedHomotopyClasses
    (M : AbstractSimplicialComplex V) (b : V)
    (G : AddCommGrpCat.{u}) (q : ℕ) :=
  NativeHomotopyClass
    (orderedComplexBasepointSubcomplex M b) (F G q)

/-- Genuine relative mapping classes from the cone, zero both on its bottom
and along the cone on the chosen basepoint.  This is the native target of the
transgression in (4.18). -/
abbrev NativeConePairHomotopyClasses
    (M : AbstractSimplicialComplex V) (b : V)
    (G : AddCommGrpCat.{u}) (q : ℕ) :=
  NativeHomotopyClass
    (conePairBoundary (orderedComplexBasepointSubcomplex M b)) (F G q)

/-- The native quotient map from pointed maps to pointed homotopy classes. -/
abbrev nativePointedHomotopyClassLinear
    (M : AbstractSimplicialComplex V) (b : V)
    (G : AddCommGrpCat.{u}) (q : ℕ) :
    NativePointedMaps M b G q →ₗ[ℤ]
      NativePointedHomotopyClasses M b G q :=
  homotopyClassLinear (orderedComplexBasepointSubcomplex M b) (F G q)

/-- Pointed homotopy classes are literally pointed maps modulo the subgroup
of maps which are relatively nullhomotopic at the chosen vertex. -/
def nativePointedQuotientEquiv
    (M : AbstractSimplicialComplex V) (b : V)
    (G : AddCommGrpCat.{u}) (q : ℕ) :
    (NativePointedMaps M b G q ⧸
        NativeNullMaps (orderedComplexBasepointSubcomplex M b) (F G q))
      ≃ₗ[ℤ] NativePointedHomotopyClasses M b G q :=
  quotientNativeNullEquiv (orderedComplexBasepointSubcomplex M b) (F G q)

@[simp]
theorem nativePointedQuotientEquiv_mkQ
    (M : AbstractSimplicialComplex V) (b : V)
    (G : AddCommGrpCat.{u}) (q : ℕ)
    (f : NativePointedMaps M b G q) :
    nativePointedQuotientEquiv M b G q
        ((NativeNullMaps
          (orderedComplexBasepointSubcomplex M b) (F G q)).mkQ f) =
      f.homotopyClass :=
  quotientNativeNullEquiv_mkQ
    (orderedComplexBasepointSubcomplex M b) (F G q) f

end GeneralSphereT.Section4
