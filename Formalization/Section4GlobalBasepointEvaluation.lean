import Formalization.Section4StrictFSectionsNativeKernel
import Formalization.Section4NativeFiberMaps
import Formalization.Section4SimplicialBasepointLift
import Formalization.Section4GlobalRprimFiberMap

set_option linter.style.header false
set_option backward.isDefEq.respectTransparency false

/-!
# Section 4: genuine evaluation at the chosen basepoint

The based algebraic row uses evaluation on the singleton facet `{b}`.  The
native pointed mapping space instead asks that the whole simplicial
subcomplex generated by the vertex `b` be sent to zero.  This file proves
that these are literally the same condition for the global Dold--Kan
evaluation map.
-/

noncomputable section

open CategoryTheory CategoryTheory.Category Opposite Simplicial

namespace GeneralSphereT.SimplicialCochain

open GeneralSphereT.PathAlgebra
open GeneralSphereT.PathAlgebra.FacetRestrictionData
open GeneralSphereT.StandardModels
open GeneralSphereT.Section4
open GeneralSphereT.Section4.UnderlyingSSet

universe u

variable {V G : Type u} [LinearOrder V] [Fintype V] [AddCommGroup G]

/-- The chosen vertex, bundled as a nondegenerate zero-simplex. -/
def basepointNonDegenerate
    (M : AbstractSimplicialComplex V) (b : V) :
    (orderedComplexSSet M).nonDegenerate 0 :=
  ⟨orderedComplexVertex M b,
    (mem_orderedComplexSSet_nonDegenerate_iff_injective M _).2 (by
      intro i j _
      fin_cases i
      fin_cases j
      rfl)⟩

@[simp]
theorem basepointNonDegenerate_coe
    (M : AbstractSimplicialComplex V) (b : V) :
    (basepointNonDegenerate M b).1 = orderedComplexVertex M b :=
  rfl

@[simp]
theorem basepointNonDegenerate_facet
    (M : AbstractSimplicialComplex V) (b : V) :
    nonDegenerateSimplexFacet M (basepointNonDegenerate M b) =
      basepointFacet M b := by
  apply Subtype.ext
  ext v
  simp [nonDegenerateSimplexFacet, basepointNonDegenerate,
    orderedSimplexSupport, basepointFacet]

/-- Genuine global evaluation is zero at the chosen vertex exactly when the
underlying distribution restricts to zero on the singleton facet. -/
theorem globalCochainRestrictionMap_vertex_eq_zero_iff
    (M : AbstractSimplicialComplex V) (b : V) (q : ℕ)
    (u : RedDist (Cochain M q G)) :
    (globalCochainRestrictionMap M q u).app
          (Opposite.op (SimplexCategory.mk 0))
          (orderedComplexVertex M b) = 0 ↔
      mapRedDist (restrictCochain (G := G) M q (basepointFacet M b)) u = 0 := by
  let x := basepointNonDegenerate M b
  have hfacet : nonDegenerateSimplexFacet M x = basepointFacet M b :=
    basepointNonDegenerate_facet M b
  rw [← hfacet]
  let e := localCochainLValue (G := G) M q 0 x
  have hfactor :
      cochainLValue M q (Opposite.op (SimplexCategory.mk 0))
          (orderedComplexVertex M b) =
        e ∘ restrictCochain (G := G) M q
          (nonDegenerateSimplexFacet M x) := by
    funext c
    change cochainLValue M q (Opposite.op (SimplexCategory.mk 0)) x.1 c = _
    rw [← localCochainLValue_restrict M q 0 x c]
    rfl
  rw [globalCochainRestrictionMap_app_apply, hfactor,
    ← mapRedDistFn_comp_apply, mapRedDist_eq_mapRedDistFn]
  constructor
  · intro h
    change mapRedDistFn e
      (mapRedDistFn
        (restrictCochain (G := G) M q
          (nonDegenerateSimplexFacet M x)) u) =
        (0 : RedDist ((L (AddCommGrpCat.of G) (q + 1)).obj
          (Opposite.op (SimplexCategory.mk 0)))) at h
    apply mapRedDistFn_injective_of_injective e
      (localCochainLValue_injective M q 0 x)
    simpa using h
  · intro h
    change mapRedDistFn
      (restrictCochain (G := G) M q
        (nonDegenerateSimplexFacet M x)) u = 0 at h
    simpa [h] using
      (map_zero (mapRedDistFn e) : mapRedDistFn e 0 = 0)

/-- Sending the simplicial subcomplex generated by `b` to zero is equivalent
to sending its unique nondegenerate vertex to zero. -/
theorem basepoint_comp_globalCochainRestrictionMap_eq_zero_iff
    (M : AbstractSimplicialComplex V) (b : V) (q : ℕ)
    (u : RedDist (Cochain M q G)) :
    (orderedComplexBasepointSubcomplex M b).ι ≫
          globalCochainRestrictionMap M q u = 0 ↔
      mapRedDist (restrictCochain (G := G) M q (basepointFacet M b)) u = 0 := by
  rw [← globalCochainRestrictionMap_vertex_eq_zero_iff M b q u]
  let A := reducedFree (L (AddCommGrpCat.of G) (q + 1))
  let y := (globalCochainRestrictionMap M q u).app
    (Opposite.op (SimplexCategory.mk 0)) (orderedComplexVertex M b)
  have hcomp :
      (orderedComplexBasepointSubcomplex M b).ι ≫
          globalCochainRestrictionMap M q u =
        SSet.const (X := (orderedComplexBasepointSubcomplex M b : SSet)) y := by
    rw [orderedComplexBasepointSubcomplex, SSet.Subcomplex.ofSimplex_ι,
      SSet.const_comp]
  rw [hcomp]
  constructor
  · intro h
    let z : (orderedComplexBasepointSubcomplex M b : SSet).obj
        (Opposite.op (SimplexCategory.mk 0)) :=
      ⟨orderedComplexVertex M b,
        SSet.Subcomplex.mem_ofSimplex_obj (orderedComplexVertex M b)⟩
    have hz := ConcreteCategory.congr_hom (congr_app h
      (Opposite.op (SimplexCategory.mk 0))) z
    have hconst :
        (SimplexCategory.mk 0).const (SimplexCategory.mk 0) 0 =
          𝟙 (SimplexCategory.mk 0) :=
      Subsingleton.elim _ _
    change (A.map
      ((SimplexCategory.mk 0).const (SimplexCategory.mk 0) 0).op).hom y = 0 at hz
    have hop : (𝟙 (SimplexCategory.mk 0)).op =
        𝟙 (Opposite.op (SimplexCategory.mk 0)) := rfl
    rw [hconst, hop, A.map_id] at hz
    exact hz
  · intro hy
    change y = 0 at hy
    rw [hy]
    exact GeneralSphereT.Section4.RelativeMapping.const_zeroVertex_eq_zeroMap
      (X := (orderedComplexBasepointSubcomplex M b : SSet)) A

/-- Based evaluation of a compatible representative agrees exactly with the
native pointed condition after genuine simplexwise evaluation. -/
theorem fCompatible_basepoint_native_eq_zero_iff
    (M : AbstractSimplicialComplex V) (b : V) (q : ℕ)
    (u : fCompatibleRedDist (facetRestrictionData (G := G) M q)) :
    (orderedComplexBasepointSubcomplex M b).ι ≫
          globalCochainRestrictionMap M q
            (u : RedDist (Cochain M q G)) = 0 ↔
      evalFCompatible (facetRestrictionData (G := G) M q)
          (basepointFacet M b) u = 0 := by
  rw [basepoint_comp_globalCochainRestrictionMap_eq_zero_iff]
  constructor
  · intro h
    apply Subtype.ext
    exact h
  · intro h
    exact congrArg Subtype.val h

/-- For a genuine fibre map represented by a primitive relation, the native
pointed condition is exactly the based condition in the algebraic row. -/
theorem rprimToNativeFiberMap_basepoint_eq_zero_iff
    (M : AbstractSimplicialComplex V) (b : V) (q : ℕ)
    (r : Rprim (d := coboundaryToRange (G := G) M q)) :
    (orderedComplexBasepointSubcomplex M b).ι ≫
          rprimToNativeFiberMap M q r = 0 ↔
      evalRprim (facetRestrictionData (G := G) M q)
          (basepointFacet M b) r = 0 := by
  let iF := underlyingMap (Fι (AddCommGrpCat.of G) (q + 1))
  have hL :
      (orderedComplexBasepointSubcomplex M b).ι ≫
            globalCochainRestrictionMap M q
              (r : RedDist (Cochain M q G)) = 0 ↔
        evalRprim (facetRestrictionData (G := G) M q)
            (basepointFacet M b) r = 0 := by
    rw [basepoint_comp_globalCochainRestrictionMap_eq_zero_iff]
    constructor
    · intro h
      apply Subtype.ext
      exact h
    · intro h
      exact congrArg Subtype.val h
  constructor
  · intro h
    apply hL.mp
    calc
      (orderedComplexBasepointSubcomplex M b).ι ≫
          globalCochainRestrictionMap M q
            (r : RedDist (Cochain M q G)) =
        (orderedComplexBasepointSubcomplex M b).ι ≫
          (rprimToNativeFiberMap M q r ≫ iF) := by
            rw [rprimToNativeFiberMap_comp_inclusion]
      _ = ((orderedComplexBasepointSubcomplex M b).ι ≫
            rprimToNativeFiberMap M q r) ≫ iF :=
        (Category.assoc _ _ _).symm
      _ = 0 := by
        rw [h]
        ext Δ x
        change ((Fι (AddCommGrpCat.of G) (q + 1)).app Δ).hom 0 = 0
        exact map_zero ((Fι (AddCommGrpCat.of G) (q + 1)).app Δ).hom
  · intro h
    apply (cancel_mono iF).1
    rw [Category.assoc, rprimToNativeFiberMap_comp_inclusion]
    have hz := hL.mpr h
    rw [hz]
    ext Δ x
    change 0 = ((Fι (AddCommGrpCat.of G) (q + 1)).app Δ).hom 0
    exact (map_zero ((Fι (AddCommGrpCat.of G) (q + 1)).app Δ).hom).symm

end GeneralSphereT.SimplicialCochain
