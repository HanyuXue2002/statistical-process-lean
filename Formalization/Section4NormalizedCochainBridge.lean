import Formalization.Section4OrderedComplexSSet
import Mathlib.Algebra.Category.Grp.Colimits
import Mathlib.AlgebraicTopology.SimplicialSet.Homology.Nondegenerate

set_option linter.style.header false

/-!
# Section 4: cochains as maps out of normalized simplicial chains

For the honest simplicial set associated with an ordered simplicial complex,
Mathlib's normalized chains are freely generated by the nondegenerate
simplices.  Since these simplices are exactly the oriented simplices used in
the paper, degreewise cochains identify with homomorphisms from normalized
chains.  This is the coordinate-free starting point for the natural
Dold--Kan construction of the `L(G,q)`-valued simplicial map.
-/

noncomputable section

open CategoryTheory CategoryTheory.Category CategoryTheory.Limits Opposite Simplicial

namespace GeneralSphereT.SimplicialCochain

universe u

variable {V G : Type u} [LinearOrder V] [Fintype V] [AddCommGroup G]

/-- A universe-polymorphic copy of the infinite cyclic group. -/
abbrev integralCoefficients : AddCommGrpCat.{u} :=
  AddCommGrpCat.of (ULift.{u} ℤ)

/-- Degree-`n` cochains expressed as homomorphisms from the normalized
integral chains of the ordered-complex simplicial set. -/
abbrev NormalizedCochainHom (M : AbstractSimplicialComplex V) (n : ℕ) :=
  ((orderedComplexSSet M).normalizedChainComplex integralCoefficients).X n ⟶
    AddCommGrpCat.of G

/-- The homomorphism `ℤ → G` which sends `1` to `g`. -/
def integerGeneratorHom (g : G) : integralCoefficients ⟶ AddCommGrpCat.of G :=
  AddCommGrpCat.ofHom
    { toFun := fun z => z.down • g
      map_zero' := by simp
      map_add' := fun z z' => by simp [add_zsmul] }

@[simp]
theorem integerGeneratorHom_apply (g : G) (z : ULift.{u} ℤ) :
    integerGeneratorHom g z = z.down • g :=
  rfl

@[simp]
theorem integerGeneratorHom_one (g : G) :
    integerGeneratorHom g (ULift.up (1 : ℤ)) = g := by
  change (1 : ℤ) • g = g
  simp

/-- Reconstruct a homomorphism out of normalized chains from its value on
every oriented simplex. -/
def normalizedCochainOfFunction (M : AbstractSimplicialComplex V) (n : ℕ)
    (a : Simplex M n → G) : NormalizedCochainHom (G := G) M n :=
  ((orderedComplexSSet M).isColimitCofanNormalizedChainComplex
      integralCoefficients n).desc
    (Cofan.mk (AddCommGrpCat.of G) fun x =>
      integerGeneratorHom (a (nonDegenerateSimplexEquiv M n x)))

@[reassoc]
theorem ιNormalizedChainComplex_normalizedCochainOfFunction
    (M : AbstractSimplicialComplex V) (n : ℕ)
    (a : Simplex M n → G)
    (x : (orderedComplexSSet M).nonDegenerate n) :
    (orderedComplexSSet M).ιNormalizedChainComplex x.1 ≫
        normalizedCochainOfFunction M n a =
      integerGeneratorHom (a (nonDegenerateSimplexEquiv M n x)) := by
  exact ((orderedComplexSSet M).isColimitCofanNormalizedChainComplex
    integralCoefficients n).fac _ ⟨x⟩

/-- Read the coefficient of every oriented simplex from a homomorphism out
of normalized chains. -/
def normalizedCochainToFunction (M : AbstractSimplicialComplex V) (n : ℕ)
    (φ : NormalizedCochainHom (G := G) M n) : Simplex M n → G :=
  fun s =>
    φ ((orderedComplexSSet M).ιNormalizedChainComplex
      (R := integralCoefficients)
      ((nonDegenerateSimplexEquiv M n).symm s).1 (ULift.up (1 : ℤ)))

theorem normalizedCochainToFunction_normalizedCochainOfFunction
    (M : AbstractSimplicialComplex V) (n : ℕ)
    (a : Simplex M n → G) :
    normalizedCochainToFunction M n (normalizedCochainOfFunction M n a) = a := by
  funext s
  let x := (nonDegenerateSimplexEquiv M n).symm s
  have h := CategoryTheory.congr_fun
    (ιNormalizedChainComplex_normalizedCochainOfFunction M n a x)
      (ULift.up (1 : ℤ))
  change (normalizedCochainOfFunction M n a)
      ((orderedComplexSSet M).ιNormalizedChainComplex
        (R := integralCoefficients) x.1 (ULift.up (1 : ℤ))) = a s
  rw [← integerGeneratorHom_one (a s)]
  simpa [x] using h

theorem normalizedCochainOfFunction_normalizedCochainToFunction
    (M : AbstractSimplicialComplex V) (n : ℕ)
    (φ : NormalizedCochainHom (G := G) M n) :
    normalizedCochainOfFunction M n (normalizedCochainToFunction M n φ) = φ := by
  apply (orderedComplexSSet M).normalizedChainComplex_hom_ext
    (R := integralCoefficients)
  intro x hx
  let x' : (orderedComplexSSet M).nonDegenerate n := ⟨x, hx⟩
  rw [ιNormalizedChainComplex_normalizedCochainOfFunction M n _ x']
  ext z
  simp only [integerGeneratorHom_apply, normalizedCochainToFunction]
  rw [Equiv.symm_apply_apply]
  change z.down • (((orderedComplexSSet M).ιNormalizedChainComplex
      (R := integralCoefficients) x ≫ φ) (ULift.up (1 : ℤ))) =
    ((orderedComplexSSet M).ιNormalizedChainComplex x ≫ φ) z
  let h := ((orderedComplexSSet M).ιNormalizedChainComplex
    (R := integralCoefficients) x ≫ φ).hom
  have hu : z.down • (ULift.up (1 : ℤ) : ULift.{u} ℤ) = z := by
    apply ULift.ext
    simp
  calc
    z.down • h (ULift.up (1 : ℤ)) =
        h (z.down • (ULift.up (1 : ℤ) : ULift.{u} ℤ)) :=
      (h.map_zsmul z.down (ULift.up (1 : ℤ))).symm
    _ = h z := congrArg h hu

/-- Homomorphisms from normalized chains are exactly coefficient functions
on oriented simplices. -/
def normalizedCochainHomEquivFunction
    (M : AbstractSimplicialComplex V) (n : ℕ) :
    NormalizedCochainHom (G := G) M n ≃+ (Simplex M n → G) where
  toFun := normalizedCochainToFunction M n
  invFun := normalizedCochainOfFunction M n
  left_inv := normalizedCochainOfFunction_normalizedCochainToFunction M n
  right_inv := normalizedCochainToFunction_normalizedCochainOfFunction M n
  map_add' φ ψ := by
    funext s
    rfl

/-- The paper's finite cochain group is canonically the group of maps from
the corresponding degree of normalized integral chains. -/
def cochainEquivNormalizedCochainHom
    (M : AbstractSimplicialComplex V) (n : ℕ) :
    Cochain M n G ≃+ NormalizedCochainHom (G := G) M n :=
  (Finsupp.linearEquivFunOnFinite ℤ G (Simplex M n)).toAddEquiv.trans
    (normalizedCochainHomEquivFunction M n).symm

@[simp]
theorem cochainEquivNormalizedCochainHom_generator
    (M : AbstractSimplicialComplex V) (n : ℕ)
    (c : Cochain M n G) (s : Simplex M n) :
    (cochainEquivNormalizedCochainHom M n c)
        ((orderedComplexSSet M).ιNormalizedChainComplex
          (R := integralCoefficients)
          ((nonDegenerateSimplexEquiv M n).symm s).1
            (ULift.up (1 : ℤ))) = c s := by
  change (normalizedCochainOfFunction M n (fun t => c t))
      ((orderedComplexSSet M).ιNormalizedChainComplex
        (R := integralCoefficients)
        ((nonDegenerateSimplexEquiv M n).symm s).1
        (ULift.up (1 : ℤ))) = c s
  rw [← integerGeneratorHom_one (c s)]
  simpa only [ConcreteCategory.comp_apply, Equiv.apply_symm_apply] using
    CategoryTheory.congr_fun
      (ιNormalizedChainComplex_normalizedCochainOfFunction M n
        (fun t => c t) ((nonDegenerateSimplexEquiv M n).symm s))
      (ULift.up (1 : ℤ))

/-! ## Compatibility with the alternating boundary -/

/-- A face of a nondegenerate ordered simplex is again nondegenerate. -/
def orderedNonDegenerateFace
    (M : AbstractSimplicialComplex V) {n : ℕ}
    (x : (orderedComplexSSet M).nonDegenerate (n + 1))
    (i : Fin (n + 2)) :
    (orderedComplexSSet M).nonDegenerate n := by
  refine ⟨(orderedComplexSSet M).δ i x.1, ?_⟩
  rw [mem_orderedComplexSSet_nonDegenerate_iff_injective]
  exact ((mem_orderedComplexSSet_nonDegenerate_iff_injective M x.1).1 x.2).comp
    (Fin.succAboveOrderEmb i).injective

@[simp]
theorem orderedNonDegenerateFace_apply
    (M : AbstractSimplicialComplex V) {n : ℕ}
    (x : (orderedComplexSSet M).nonDegenerate (n + 1))
    (i : Fin (n + 2)) (j : Fin (n + 1)) :
    (orderedNonDegenerateFace M x i).1.1 j = x.1.1 (i.succAbove j) :=
  rfl

/-- The vertices of a nondegenerate ordered simplex are enumerated, without
repetition, by its finite ordinal of positions. -/
def orderedNonDegenerateVertexEquiv
    (M : AbstractSimplicialComplex V) {n : ℕ}
    (x : (orderedComplexSSet M).nonDegenerate n) :
    Fin (n + 1) ≃ (nonDegenerateSimplexEquiv M n x).1 :=
  Equiv.ofBijective
    (fun i => ⟨x.1.1 i, by simp [nonDegenerateSimplexEquiv,
      orderedSimplexSupport]⟩)
    ⟨fun i j h =>
        ((mem_orderedComplexSSet_nonDegenerate_iff_injective M x.1).1 x.2)
          (congrArg Subtype.val h),
      fun v => by
        rcases v with ⟨v, hv⟩
        change v ∈ orderedSimplexSupport x.1.1 at hv
        rw [mem_orderedSimplexSupport] at hv
        rcases hv with ⟨i, hi⟩
        refine ⟨i, Subtype.ext ?_⟩
        exact hi⟩

@[simp]
theorem orderedNonDegenerateVertexEquiv_apply
    (M : AbstractSimplicialComplex V) {n : ℕ}
    (x : (orderedComplexSSet M).nonDegenerate n) (i : Fin (n + 1)) :
    ((orderedNonDegenerateVertexEquiv M x i :
      (nonDegenerateSimplexEquiv M n x).1) : V) = x.1.1 i :=
  rfl

/-- In the paper's simplex coordinates, taking the `i`th simplicial face is
exactly deleting the vertex in position `i`. -/
theorem nonDegenerateSimplexEquiv_orderedNonDegenerateFace
    (M : AbstractSimplicialComplex V) {n : ℕ}
    (x : (orderedComplexSSet M).nonDegenerate (n + 1))
    (i : Fin (n + 2)) :
    nonDegenerateSimplexEquiv M n (orderedNonDegenerateFace M x i) =
      eraseVertex M (nonDegenerateSimplexEquiv M (n + 1) x)
        (x.1.1 i) (orderedNonDegenerateVertexEquiv M x i).2 := by
  apply Subtype.ext
  ext v
  change v ∈ orderedSimplexSupport (orderedNonDegenerateFace M x i).1.1 ↔
    v ∈ (orderedSimplexSupport x.1.1).erase (x.1.1 i)
  rw [mem_orderedSimplexSupport, Finset.mem_erase,
    mem_orderedSimplexSupport]
  constructor
  · rintro ⟨j, hj⟩
    refine ⟨?_, ⟨i.succAbove j, hj⟩⟩
    intro hvi
    exact Fin.succAbove_ne i j
      (((mem_orderedComplexSSet_nonDegenerate_iff_injective M x.1).1 x.2)
        (hj.trans hvi))
  · rintro ⟨hvi, j, hj⟩
    obtain ⟨j', hj'⟩ := (finSuccAboveEquiv i).surjective
      ⟨j, fun h => hvi (hj.symm.trans (congrArg x.1.1 h))⟩
    refine ⟨j', ?_⟩
    exact congrArg x.1.1 (congrArg Subtype.val hj') |>.trans hj

/-- The incidence sign at the vertex in position `i` is `(-1)^i`. -/
theorem incidenceSign_nonDegenerateSimplexEquiv
    (M : AbstractSimplicialComplex V) {n : ℕ}
    (x : (orderedComplexSSet M).nonDegenerate (n + 1))
    (i : Fin (n + 2)) :
    incidenceSign M (nonDegenerateSimplexEquiv M (n + 1) x) (x.1.1 i) =
      (-1 : ℤ) ^ (i : ℕ) := by
  unfold incidenceSign
  congr 1
  change ((Finset.univ.image x.1.1).filter fun w => w < x.1.1 i).card = i
  rw [Finset.filter_image, Finset.card_image_of_injective _
    ((mem_orderedComplexSSet_nonDegenerate_iff_injective M x.1).1 x.2)]
  change (Finset.univ.filter fun j : Fin (n + 2) => x.1.1 j < x.1.1 i).card = i
  have hfilter : (Finset.univ.filter fun j : Fin (n + 2) => x.1.1 j < x.1.1 i) =
      Finset.Iio i := by
    ext j
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_Iio]
    exact ((x.1.1.monotone.strictMono_of_injective
      ((mem_orderedComplexSSet_nonDegenerate_iff_injective M x.1).1 x.2)).lt_iff_lt)
  rw [hfilter, Fin.card_Iio]

/-- The paper's coboundary, evaluated on an ordered nondegenerate simplex,
is the usual alternating sum over its ordered faces. -/
theorem coboundary_nonDegenerateSimplexEquiv
    (M : AbstractSimplicialComplex V) (n : ℕ)
    (c : Cochain M n G)
    (x : (orderedComplexSSet M).nonDegenerate (n + 1)) :
    coboundary M n c (nonDegenerateSimplexEquiv M (n + 1) x) =
      ∑ i : Fin (n + 2), (-1 : ℤ) ^ (i : ℕ) •
        c (nonDegenerateSimplexEquiv M n
          (orderedNonDegenerateFace M x i)) := by
  rw [coboundary_apply]
  symm
  refine Fintype.sum_equiv (orderedNonDegenerateVertexEquiv M x)
    (fun i : Fin (n + 2) => (-1 : ℤ) ^ (i : ℕ) •
      c (nonDegenerateSimplexEquiv M n
        (orderedNonDegenerateFace M x i)))
    (fun v : (nonDegenerateSimplexEquiv M (n + 1) x).1 =>
      incidenceSign M (nonDegenerateSimplexEquiv M (n + 1) x) v.1 •
        c (eraseVertex M (nonDegenerateSimplexEquiv M (n + 1) x)
          v.1 v.2)) fun i => ?_
  simp only [orderedNonDegenerateVertexEquiv_apply,
    incidenceSign_nonDegenerateSimplexEquiv]
  congr 1
  exact congrArg c
    (nonDegenerateSimplexEquiv_orderedNonDegenerateFace M x i)

/-- An additive map out of the universe-lifted infinite cyclic group is
determined by the image of its canonical generator. -/
theorem integralCoefficients_hom_ext
    (f g : integralCoefficients ⟶ AddCommGrpCat.of G)
    (h : f (ULift.up (1 : ℤ)) = g (ULift.up (1 : ℤ))) : f = g := by
  ext z
  let fu := f.hom
  let gu := g.hom
  have hu : z.down • (ULift.up (1 : ℤ) : ULift.{u} ℤ) = z := by
    apply ULift.ext
    simp
  calc
    f z = z.down • f (ULift.up (1 : ℤ)) := by
      rw [← fu.map_zsmul]
      exact congrArg f hu.symm
    _ = z.down • g (ULift.up (1 : ℤ)) := congrArg (z.down • ·) h
    _ = g z := by
      rw [← gu.map_zsmul]
      exact congrArg g hu

@[simp]
theorem cochainEquivNormalizedCochainHom_nonDegenerate_generator
    (M : AbstractSimplicialComplex V) (n : ℕ)
    (c : Cochain M n G)
    (x : (orderedComplexSSet M).nonDegenerate n) :
    (cochainEquivNormalizedCochainHom M n c)
        ((orderedComplexSSet M).ιNormalizedChainComplex
          (R := integralCoefficients) x.1 (ULift.up (1 : ℤ))) =
      c (nonDegenerateSimplexEquiv M n x) := by
  simpa using cochainEquivNormalizedCochainHom_generator M n c
    (nonDegenerateSimplexEquiv M n x)

theorem addCommGrpCat_fintype_sum_apply
    {ι : Type*} [Fintype ι] {A B : AddCommGrpCat.{u}}
    (f : ι → (A ⟶ B)) (a : A) :
    (∑ i, f i) a = ∑ i, f i a := by
  classical
  let s : Finset ι := Finset.univ
  change (s.sum f) a = s.sum fun i => f i a
  induction s using Finset.induction_on with
  | empty => rfl
  | @insert i s hi ih =>
      simp only [Finset.sum_insert hi, AddCommGrpCat.hom_add_apply, ih]

@[simp]
theorem addCommGrpCat_zsmul_apply
    {A B : AddCommGrpCat.{u}} (m : ℤ) (f : A ⟶ B) (a : A) :
    (m • f) a = m • f a :=
  rfl

/-- Under the normalized-chain identification, the paper's coboundary is
precomposition with the normalized simplicial boundary. -/
theorem cochainEquivNormalizedCochainHom_coboundary
    (M : AbstractSimplicialComplex V) (n : ℕ) (c : Cochain M n G) :
    cochainEquivNormalizedCochainHom M (n + 1) (coboundary M n c) =
      ((orderedComplexSSet M).normalizedChainComplex integralCoefficients).d
          (n + 1) n ≫
        cochainEquivNormalizedCochainHom M n c := by
  apply (orderedComplexSSet M).normalizedChainComplex_hom_ext
    (R := integralCoefficients)
  intro y hy
  let x : (orderedComplexSSet M).nonDegenerate (n + 1) := ⟨y, hy⟩
  rw [← Category.assoc,
    (orderedComplexSSet M).ιNormalizedChainComplex_d,
    Preadditive.sum_comp]
  apply integralCoefficients_hom_ext
  simp only [ConcreteCategory.comp_apply]
  rw [cochainEquivNormalizedCochainHom_nonDegenerate_generator M (n + 1)
    (coboundary M n c) x]
  rw [coboundary_nonDegenerateSimplexEquiv M n c x]
  simp only [Preadditive.zsmul_comp]
  rw [addCommGrpCat_fintype_sum_apply]
  simp only [addCommGrpCat_zsmul_apply, ConcreteCategory.comp_apply]
  apply Finset.sum_congr rfl
  intro i hi
  congr 1
  exact (cochainEquivNormalizedCochainHom_nonDegenerate_generator
    M n c (orderedNonDegenerateFace M x i)).symm

end GeneralSphereT.SimplicialCochain
