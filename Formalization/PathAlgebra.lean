import Mathlib

set_option linter.style.header false

/-!
# The first path-algebra milestone

This file formalizes the smallest algebraic layer used by the proof:

* `Dist X` is the free abelian group on configurations in `X`;
* `Path I X` is the free abelian group on pairs `(r, x)`, modulo every
  generator whose increment is zero;
* the boundary of `[r; x]` is `⟨x + φ r⟩ - ⟨x⟩`;
* normalizing the base variable gives the three-term formula from the paper.

No locality, cone, or simplicial-topology claim is included in this milestone.
-/

noncomputable section

namespace GeneralSphereT.PathAlgebra

/-- The free abelian group on a type `X`. -/
abbrev Dist (X : Type*) := X →₀ ℤ

/-- The reduced generator `⟨x⟩ = [x] - [0]`. -/
def bracket {X : Type*} [AddCommGroup X] (x : X) : Dist X :=
  Finsupp.single x 1 - Finsupp.single 0 1

@[simp]
theorem bracket_zero {X : Type*} [AddCommGroup X] :
    bracket (0 : X) = 0 := by
  simp [bracket]

/-- The free abelian group on increment/base pairs, before imposing `[0; x] = 0`. -/
abbrev RawPath (I X : Type*) := (I × X) →₀ ℤ

/-- The subgroup generated by all paths with zero increment. -/
def zeroIncrement (I X : Type*) [AddCommGroup I] :
    Submodule ℤ (RawPath I X) :=
  Submodule.span ℤ (Set.range fun x : X => Finsupp.single ((0 : I), x) 1)

/-- Paths modulo precisely the generators `[0; x]`. -/
abbrev Path (I X : Type*) [AddCommGroup I] :=
  RawPath I X ⧸ zeroIncrement I X

/-- A generator before taking the zero-increment quotient. -/
def rawEdge {I X : Type*} (r : I) (x : X) : RawPath I X :=
  Finsupp.single (r, x) 1

/-- The path generator `[r; x]`. -/
def edge {I X : Type*} [AddCommGroup I] (r : I) (x : X) : Path I X :=
  (zeroIncrement I X).mkQ (rawEdge r x)

variable {I X : Type*} [AddCommGroup I] [AddCommGroup X]

/-- The boundary on the free group before taking the zero-increment quotient. -/
def rawBoundary (φ : I →+ X) : RawPath I X →ₗ[ℤ] Dist X :=
  Finsupp.linearCombination ℤ fun p =>
    bracket (p.2 + φ p.1) - bracket p.2

@[simp]
theorem rawBoundary_rawEdge (φ : I →+ X) (r : I) (x : X) :
    rawBoundary φ (rawEdge r x) =
      bracket (x + φ r) - bracket x := by
  simp [rawBoundary, rawEdge]

/-- The raw boundary kills every relation used in the path quotient. -/
theorem zeroIncrement_le_ker (φ : I →+ X) :
    zeroIncrement I X ≤ LinearMap.ker (rawBoundary φ) := by
  rw [zeroIncrement, Submodule.span_le]
  rintro _ ⟨x, rfl⟩
  simp [rawBoundary, bracket]

/-- The well-defined boundary on the quotient `Path I X`. -/
def boundary (φ : I →+ X) : Path I X →ₗ[ℤ] Dist X :=
  (zeroIncrement I X).liftQ (rawBoundary φ) (zeroIncrement_le_ker φ)

@[simp]
theorem boundary_edge (φ : I →+ X) (r : I) (x : X) :
    boundary φ (edge r x) = bracket (x + φ r) - bracket x := by
  simp [boundary, edge]

omit [AddCommGroup X] in
@[simp]
theorem edge_zero_increment (x : X) : edge (0 : I) x = 0 := by
  apply (Submodule.Quotient.mk_eq_zero (zeroIncrement I X)).2
  exact Submodule.subset_span (Set.mem_range_self x)

omit [AddCommGroup X] in
/-- Evaluation at `(r, x)` kills the zero-increment relations whenever `r ≠ 0`. -/
theorem zeroIncrement_le_evaluation_ker {r : I} (hr : r ≠ 0) (x : X) :
    zeroIncrement I X ≤ LinearMap.ker (Finsupp.lapply (r, x)) := by
  classical
  rw [zeroIncrement, Submodule.span_le]
  rintro _ ⟨y, rfl⟩
  simp [hr]

omit [AddCommGroup X] in
/-- A nonzero increment is not accidentally killed by the quotient. -/
theorem edge_ne_zero {r : I} (hr : r ≠ 0) (x : X) : edge r x ≠ 0 := by
  intro h
  change Submodule.Quotient.mk (rawEdge r x) = 0 at h
  have hmem : rawEdge r x ∈ zeroIncrement I X :=
    (Submodule.Quotient.mk_eq_zero (zeroIncrement I X)).1 h
  have heval : Finsupp.lapply (r, x) (rawEdge r x) = 0 :=
    zeroIncrement_le_evaluation_ker hr x hmem
  simp [rawEdge] at heval

omit [AddCommGroup X] in
/-- A path generator vanishes exactly when its increment is zero. -/
theorem edge_eq_zero_iff (r : I) (x : X) : edge r x = 0 ↔ r = 0 := by
  constructor
  · intro h
    by_contra hr
    exact (edge_ne_zero hr x) h
  · rintro rfl
    exact edge_zero_increment x

/-- In particular, `[r; 0]` remains nonzero for every nonzero increment `r`. -/
theorem edge_zero_base_ne_zero {r : I} (hr : r ≠ 0) :
    edge r (0 : X) ≠ 0 :=
  edge_ne_zero hr 0

/-- The base-normalized generator `[r; x] - [r; 0]`. -/
def normalizedEdge (r : I) (x : X) : Path I X :=
  edge r x - edge r 0

/--
The normalized boundary has three terms. This is the formal regression check
for the easily missed final term `-⟨φ r⟩`.
-/
theorem boundary_normalizedEdge (φ : I →+ X) (r : I) (x : X) :
    boundary φ (normalizedEdge r x) =
      bracket (x + φ r) - bracket x - bracket (φ r) := by
  simp [normalizedEdge]

end GeneralSphereT.PathAlgebra
