import Formalization.SubdivisionNaturality

set_option linter.style.header false

/-!
# Elementary paths

The elementary subgroup is generated by edges whose increment is supported at
one coordinate and is nonzero there.  Ordered subdivision lands in this subgroup,
so its codomain can be sharpened from the ambient path group.
-/

noncomputable section

namespace GeneralSphereT.PathAlgebra

variable {ι G X : Type*}
variable [LinearOrder ι] [AddCommGroup G] [AddCommGroup X]

/-- The submodule spanned by paths with one nonzero coordinate increment. -/
def elementaryPaths :
    Submodule ℤ (Path (Configuration ι G) X) :=
  Submodule.span ℤ
    {p | ∃ (i : ι) (g : G) (x : X),
      g ≠ 0 ∧ p = edge (Finsupp.single i g) x}

omit [LinearOrder ι] [AddCommGroup X] in
theorem elementaryEdge_mem (i : ι) {g : G} (hg : g ≠ 0) (x : X) :
    edge (Finsupp.single i g) x ∈
      elementaryPaths (ι := ι) (G := G) (X := X) := by
  exact Submodule.subset_span ⟨i, g, x, hg, rfl⟩

/-- Every summand of an ordered path is elementary, hence so is the path. -/
theorem orderedPathAlong_mem (φ : Configuration ι G →+ X)
    (r : Configuration ι G) (x : X) :
    orderedPathAlong φ r x ∈
      elementaryPaths (ι := ι) (G := G) (X := X) := by
  rw [orderedPathAlong]
  apply Submodule.sum_mem
  intro i hi
  exact elementaryEdge_mem i (Finsupp.mem_support_iff.mp hi)
    (x + φ (coordinatePrefix r i))

theorem orderedPath_mem (r x : Configuration ι G) :
    orderedPath r x ∈
      elementaryPaths (ι := ι) (G := G)
        (X := Configuration ι G) := by
  rw [← orderedPathAlong_id]
  exact orderedPathAlong_mem _ r x

/-- Ordered subdivision leaves a genuinely one-coordinate edge unchanged. -/
@[simp]
theorem orderedPath_single (i : ι) {g : G} (hg : g ≠ 0)
    (x : Configuration ι G) :
    orderedPath (Finsupp.single i g) x =
      edge (Finsupp.single i g) x := by
  have hprefix :
      coordinatePrefix (Finsupp.single i g) i = 0 := by
    have hfilter :
        (Finsupp.single i g).support.filter (fun j => j < i) = ∅ := by
      apply Finset.filter_eq_empty_iff.2
      intro j hj hjlt
      have hji : j = i := by
        simpa [hg] using hj
      subst j
      exact (lt_irrefl i) hjlt
    rw [coordinatePrefix, prefixSum, hfilter]
    simp
  simp [orderedPath, hg, hprefix]

/-- The generator form of the last sentence following (2.14). -/
@[simp]
theorem subdivision_elementaryEdge (i : ι) {g : G} (hg : g ≠ 0)
    (x : Configuration ι G) :
    subdivision (edge (Finsupp.single i g) x) =
      edge (Finsupp.single i g) x := by
  simp [hg]

/-- The linear raw subdivision has elementary image. -/
theorem rawSubdivision_mem
    (p : RawPath (Configuration ι G) (Configuration ι G)) :
    rawSubdivision p ∈
      elementaryPaths (ι := ι) (G := G)
        (X := Configuration ι G) := by
  classical
  induction p using Finsupp.induction with
  | zero => simp
  | single_add a n p _ _ ih =>
      rw [map_add]
      apply Submodule.add_mem
      · simpa [rawSubdivision] using
          (Submodule.smul_mem
            (elementaryPaths (ι := ι) (G := G)
              (X := Configuration ι G)) n
            (orderedPath_mem a.1 a.2))
      · exact ih

/-- The quotient subdivision likewise has elementary image. -/
theorem subdivision_mem
    (p : Path (Configuration ι G) (Configuration ι G)) :
    subdivision p ∈
      elementaryPaths (ι := ι) (G := G)
        (X := Configuration ι G) := by
  refine Submodule.Quotient.induction_on
    (p := zeroIncrement (Configuration ι G) (Configuration ι G)) p ?_
  intro q
  change rawSubdivision q ∈
    elementaryPaths (ι := ι) (G := G)
      (X := Configuration ι G)
  exact rawSubdivision_mem q

/-- Raw subdivision with the elementary-image fact carried in its codomain. -/
def rawSubdivisionElementary :
    RawPath (Configuration ι G) (Configuration ι G) →ₗ[ℤ]
      elementaryPaths (ι := ι) (G := G)
        (X := Configuration ι G) :=
  LinearMap.codRestrict
    (elementaryPaths (ι := ι) (G := G)
      (X := Configuration ι G))
    rawSubdivision rawSubdivision_mem

/-- Subdivision with the elementary-image fact carried in its codomain. -/
def subdivisionElementary :
    Path (Configuration ι G) (Configuration ι G) →ₗ[ℤ]
      elementaryPaths (ι := ι) (G := G)
        (X := Configuration ι G) :=
  LinearMap.codRestrict
    (elementaryPaths (ι := ι) (G := G)
      (X := Configuration ι G))
    subdivision subdivision_mem

@[simp]
theorem rawSubdivisionElementary_coe
    (p : RawPath (Configuration ι G) (Configuration ι G)) :
    ((rawSubdivisionElementary p :
        elementaryPaths (ι := ι) (G := G)
          (X := Configuration ι G)) :
      Path (Configuration ι G) (Configuration ι G)) = rawSubdivision p :=
  rfl

@[simp]
theorem subdivisionElementary_coe
    (p : Path (Configuration ι G) (Configuration ι G)) :
    ((subdivisionElementary p :
        elementaryPaths (ι := ι) (G := G)
          (X := Configuration ι G)) :
      Path (Configuration ι G) (Configuration ι G)) = subdivision p :=
  rfl

/-- The raw canonical-path map also has elementary image. -/
theorem rawCanonicalPath_mem
    (u : Dist (Configuration ι G)) :
    rawCanonicalPath u ∈
      elementaryPaths (ι := ι) (G := G)
        (X := Configuration ι G) := by
  classical
  induction u using Finsupp.induction with
  | zero => simp
  | single_add c n u _ _ ih =>
      rw [map_add]
      apply Submodule.add_mem
      · simpa [rawCanonicalPath] using
          (Submodule.smul_mem
            (elementaryPaths (ι := ι) (G := G)
              (X := Configuration ι G)) n
            (orderedPath_mem c 0))
      · exact ih

/-- The reduced canonical-path map has elementary image. -/
theorem canonicalPath_mem
    (u : RedDist (Configuration ι G)) :
    canonicalPath u ∈
      elementaryPaths (ι := ι) (G := G)
        (X := Configuration ι G) := by
  exact rawCanonicalPath_mem u.1

/-- The canonical path with its elementary codomain recorded in the type. -/
def canonicalPathElementary :
    RedDist (Configuration ι G) →ₗ[ℤ]
      elementaryPaths (ι := ι) (G := G)
        (X := Configuration ι G) :=
  LinearMap.codRestrict
    (elementaryPaths (ι := ι) (G := G)
      (X := Configuration ι G))
    canonicalPath canonicalPath_mem

@[simp]
theorem canonicalPathElementary_coe
    (u : RedDist (Configuration ι G)) :
    ((canonicalPathElementary u :
        elementaryPaths (ι := ι) (G := G)
          (X := Configuration ι G)) :
      Path (Configuration ι G) (Configuration ι G)) = canonicalPath u :=
  rfl

/-- Primitive reduced boundary restricted to elementary paths. -/
def primitiveReducedBoundaryElementary :
    elementaryPaths (ι := ι) (G := G)
        (X := Configuration ι G) →ₗ[ℤ]
      RedDist (Configuration ι G) :=
  (primitiveReducedBoundary (Configuration ι G)).comp
    (elementaryPaths (ι := ι) (G := G)
      (X := Configuration ι G)).subtype

/-- The elementary-valued form of (2.16): `∂ p_* = 1`. -/
theorem primitiveReducedBoundaryElementary_canonicalPathElementary :
    (primitiveReducedBoundaryElementary (ι := ι) (G := G)).comp
        (canonicalPathElementary (ι := ι) (G := G)) =
      LinearMap.id (R := ℤ) (M := RedDist (Configuration ι G)) := by
  apply LinearMap.ext
  intro u
  exact LinearMap.congr_fun primitiveReducedBoundary_canonicalPath u

end GeneralSphereT.PathAlgebra
