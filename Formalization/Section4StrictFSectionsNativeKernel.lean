import Formalization.Section4StrictFSectionsNativeKilled
import Formalization.Section4GlobalCochainRestrictionNaturality

set_option linter.style.header false
set_option backward.isDefEq.respectTransparency false

/-!
# Section 4: the kernel of genuine cochain-distribution evaluation

The easy direction of the kernel calculation is purely local: evaluation on
a nondegenerate simplex factors through restriction to its support.  Hence a
primitive distribution which vanishes on every simplex gives the zero genuine
simplicial map.  The converse is proved below by the top-simplex
classification of a full support simplex.
-/

noncomputable section

open CategoryTheory CategoryTheory.Category CategoryTheory.Limits Opposite Simplicial

namespace GeneralSphereT.SimplicialCochain

open GeneralSphereT.PathAlgebra
open GeneralSphereT.PathAlgebra.FacetRestrictionData
open GeneralSphereT.Section4
open GeneralSphereT.StandardModels

universe u

variable {V G : Type u} [LinearOrder V] [Fintype V] [AddCommGroup G]

/-! ## The support simplex is generated by its top simplex -/

/-- The increasing enumeration of the support vertices. -/
def nonDegenerateSimplexSupportOrderIso
    (M : AbstractSimplicialComplex V) {n : ℕ}
    (x : (orderedComplexSSet M).nonDegenerate n) :
    Fin (n + 1) ≃o
      {v : V // v ∈ (nonDegenerateSimplexFacet M x).1} :=
  (nonDegenerateSimplexEquiv M n x).1.orderIsoOfFin
    (nonDegenerateSimplexEquiv M n x).2.2

@[simp]
theorem nonDegenerateSimplexSupportOrderIso_apply
    (M : AbstractSimplicialComplex V) {n : ℕ}
    (x : (orderedComplexSSet M).nonDegenerate n) (i : Fin (n + 1)) :
    nonDegenerateSimplexSupportOrderIso M x i =
      (nonDegenerateSimplexSupportTop M x).1 i := by
  apply Subtype.ext
  change (nonDegenerateSimplexEquiv M n x).1.orderEmbOfFin
      (nonDegenerateSimplexEquiv M n x).2.2 i = x.1.1 i
  have hxinj : Function.Injective x.1.1 :=
    (mem_orderedComplexSSet_nonDegenerate_iff_injective M x.1).1 x.2
  exact congrFun
    (Finset.orderEmbOfFin_unique
      (nonDegenerateSimplexEquiv M n x).2.2
      (fun j => (mem_orderedSimplexSupport x.1.1 (x.1.1 j)).2 ⟨j, rfl⟩)
      (x.1.1.monotone.strictMono_of_injective hxinj)).symm i

/-- The unique simplex-category morphism which obtains a simplex of the
full support simplex from its top simplex. -/
def nonDegenerateSimplexSupportHom
    (M : AbstractSimplicialComplex V) {n : ℕ}
    (x : (orderedComplexSSet M).nonDegenerate n)
    {Δ : SimplexCategoryᵒᵖ}
    (z : (orderedComplexSSet
      (nonDegenerateSimplexSupportComplex M x)).obj Δ) :
    Δ.unop ⟶ SimplexCategory.mk n :=
  SimplexCategory.Hom.mk
    ((nonDegenerateSimplexSupportOrderIso M x).symm.toOrderEmbedding.toOrderHom.comp z.1)

@[simp]
theorem nonDegenerateSimplexSupport_map_hom_top
    (M : AbstractSimplicialComplex V) {n : ℕ}
    (x : (orderedComplexSSet M).nonDegenerate n)
    {Δ : SimplexCategoryᵒᵖ}
    (z : (orderedComplexSSet
      (nonDegenerateSimplexSupportComplex M x)).obj Δ) :
    (orderedComplexSSet (nonDegenerateSimplexSupportComplex M x)).map
        (nonDegenerateSimplexSupportHom M x z).op
        (nonDegenerateSimplexSupportTop M x) = z := by
  apply Subtype.ext
  rw [orderedComplexSSet_map_coe]
  apply OrderHom.ext
  funext i
  change (nonDegenerateSimplexSupportTop M x).1
      ((nonDegenerateSimplexSupportOrderIso M x).symm (z.1 i)) = z.1 i
  rw [← nonDegenerateSimplexSupportOrderIso_apply]
  exact (nonDegenerateSimplexSupportOrderIso M x).apply_symm_apply (z.1 i)

/-- The basis generator indexed by the top simplex of a support simplex. -/
def nonDegenerateSimplexSupportTopGenerator
    (M : AbstractSimplicialComplex V) {n : ℕ}
    (x : (orderedComplexSSet M).nonDegenerate n) :
    (freeSimplicialAbelian
      (orderedComplexSSet (nonDegenerateSimplexSupportComplex M x))).obj
        (Opposite.op (SimplexCategory.mk n)) :=
  (Sigma.ι (fun _ :
      (orderedComplexSSet (nonDegenerateSimplexSupportComplex M x)).obj
        (Opposite.op (SimplexCategory.mk n)) => integralCoefficients)
    (nonDegenerateSimplexSupportTop M x)) (ULift.up (1 : ℤ))

/-- A morphism out of the free simplicial abelian group on a full support
simplex is determined by its value on the top generator. -/
theorem supportFreeMap_ext
    (M : AbstractSimplicialComplex V) {n : ℕ}
    (x : (orderedComplexSSet M).nonDegenerate n)
    (A : SimplicialObject AddCommGrpCat.{u})
    (f g : freeSimplicialAbelian
      (orderedComplexSSet (nonDegenerateSimplexSupportComplex M x)) ⟶ A)
    (h : f.app (Opposite.op (SimplexCategory.mk n))
          (nonDegenerateSimplexSupportTopGenerator M x) =
        g.app (Opposite.op (SimplexCategory.mk n))
          (nonDegenerateSimplexSupportTopGenerator M x)) :
    f = g := by
  apply NatTrans.ext
  funext Δ
  apply Limits.Sigma.hom_ext
  intro z
  apply integralCoefficients_hom_ext
  let θ : Opposite.op (SimplexCategory.mk n) ⟶ Δ :=
    (nonDegenerateSimplexSupportHom M x z).op
  have hgenerator :
      (freeSimplicialAbelian
        (orderedComplexSSet (nonDegenerateSimplexSupportComplex M x))).map θ
          (nonDegenerateSimplexSupportTopGenerator M x) =
        (Sigma.ι (fun _ :
          (orderedComplexSSet (nonDegenerateSimplexSupportComplex M x)).obj Δ =>
            integralCoefficients) z) (ULift.up (1 : ℤ)) := by
    have hnat := ConcreteCategory.congr_hom
      ((freeSimplicialAbelianGenerator
        (orderedComplexSSet
          (nonDegenerateSimplexSupportComplex M x))).naturality θ)
        (nonDegenerateSimplexSupportTop M x)
    symm at hnat
    simp only [ConcreteCategory.comp_apply] at hnat
    change
      (freeSimplicialAbelian
        (orderedComplexSSet (nonDegenerateSimplexSupportComplex M x))).map θ
          (nonDegenerateSimplexSupportTopGenerator M x) =
        (Sigma.ι (fun _ :
          (orderedComplexSSet (nonDegenerateSimplexSupportComplex M x)).obj Δ =>
            integralCoefficients)
          ((orderedComplexSSet
            (nonDegenerateSimplexSupportComplex M x)).map θ
              (nonDegenerateSimplexSupportTop M x)))
            (ULift.up (1 : ℤ)) at hnat
    rw [nonDegenerateSimplexSupport_map_hom_top] at hnat
    exact hnat
  have hf := ConcreteCategory.congr_hom (f.naturality θ)
    (nonDegenerateSimplexSupportTopGenerator M x)
  have hg := ConcreteCategory.congr_hom (g.naturality θ)
    (nonDegenerateSimplexSupportTopGenerator M x)
  change f.app Δ
      ((Sigma.ι (fun _ :
        (orderedComplexSSet (nonDegenerateSimplexSupportComplex M x)).obj Δ =>
          integralCoefficients) z) (ULift.up (1 : ℤ))) =
    g.app Δ
      ((Sigma.ι (fun _ :
        (orderedComplexSSet (nonDegenerateSimplexSupportComplex M x)).obj Δ =>
          integralCoefficients) z) (ULift.up (1 : ℤ)))
  calc
    _ = A.map θ
        (f.app (Opposite.op (SimplexCategory.mk n))
          (nonDegenerateSimplexSupportTopGenerator M x)) := by
      simpa only [ConcreteCategory.comp_apply, hgenerator] using hf
    _ = A.map θ
        (g.app (Opposite.op (SimplexCategory.mk n))
          (nonDegenerateSimplexSupportTopGenerator M x)) := congrArg _ h
    _ = _ := by
      simpa only [ConcreteCategory.comp_apply, hgenerator] using hg.symm

/-- On a full support simplex, evaluation of the genuine `L`-valued map on
the top simplex is injective in the defining cochain. -/
theorem supportCochainLValue_injective
    (M : AbstractSimplicialComplex V) (q : ℕ) {n : ℕ}
    (x : (orderedComplexSSet M).nonDegenerate n) :
    Function.Injective (fun c :
        Cochain (nonDegenerateSimplexSupportComplex M x) q G =>
      cochainLValue (nonDegenerateSimplexSupportComplex M x) q
        (Opposite.op (SimplexCategory.mk n))
        (nonDegenerateSimplexSupportTop M x) c) := by
  intro c c' h
  let X := orderedComplexSSet (nonDegenerateSimplexSupportComplex M x)
  let C := StandardModels.diskComplex (AddCommGrpCat.of G) (q + 1)
  have htop :
      (denormalizeNormalizedChainMap X
        (cochainDiskChainMap (nonDegenerateSimplexSupportComplex M x) q c)).app
          (Opposite.op (SimplexCategory.mk n))
          (nonDegenerateSimplexSupportTopGenerator M x) =
      (denormalizeNormalizedChainMap X
        (cochainDiskChainMap (nonDegenerateSimplexSupportComplex M x) q c')).app
          (Opposite.op (SimplexCategory.mk n))
          (nonDegenerateSimplexSupportTopGenerator M x) := by
    exact h
  have hden :
      denormalizeNormalizedChainMap X
          (cochainDiskChainMap (nonDegenerateSimplexSupportComplex M x) q c) =
        denormalizeNormalizedChainMap X
          (cochainDiskChainMap
            (nonDegenerateSimplexSupportComplex M x) q c') :=
    supportFreeMap_ext M x
      (CategoryTheory.Abelian.DoldKan.Γ.obj C) _ _ htop
  have hchain :
      cochainDiskChainMap (nonDegenerateSimplexSupportComplex M x) q c =
        cochainDiskChainMap
          (nonDegenerateSimplexSupportComplex M x) q c' :=
    (denormalizeNormalizedChainMap_bijective X C).1 hden
  apply (cochainEquivNormalizedCochainHom
    (nonDegenerateSimplexSupportComplex M x) q).injective
  rw [← cancel_mono
    (HomologicalComplex.doubleXIso₁ (𝟙 (AddCommGrpCat.of G))
      (ComplexShape.down_mk (q + 1) q rfl) (by omega)).inv]
  simpa only [cochainDiskChainMap_f_bottom] using
    HomologicalComplex.congr_hom hchain q

/-! ## Local coordinates on a support simplex -/

/-- Regard a face contained in the support as a simplex whose vertices are
elements of the support subtype. -/
def faceInToSupportSimplex
    (M : AbstractSimplicialComplex V) {n : ℕ}
    (x : (orderedComplexSSet M).nonDegenerate n) (r : ℕ)
    (τ : facesIn M r (nonDegenerateSimplexFacet M x)) :
    Simplex (nonDegenerateSimplexSupportComplex M x) r := by
  let e : {
      v : V // v ∈ τ.1.1} ↪
      {v : V // v ∈ (nonDegenerateSimplexFacet M x).1} :=
    ⟨fun v => ⟨v.1, τ.2 v.2⟩, fun a b h =>
      Subtype.ext (congrArg
        (fun z : {v : V // v ∈ (nonDegenerateSimplexFacet M x).1} => z.1) h)⟩
  refine ⟨τ.1.1.attach.map e, ?_, ?_⟩
  · change (τ.1.1.attach.map e).Nonempty
    exact Finset.map_nonempty.mpr
      (Finset.attach_nonempty_iff.mpr
        ((M.isRelLowerSet_faces τ.1.2.1).1))
  · rw [Finset.card_map, Finset.card_attach]
    exact τ.1.2.2

/-- Returning a local face to the ambient complex recovers that face. -/
@[simp]
theorem supportMap_faceInToSupportSimplex
    (M : AbstractSimplicialComplex V) {n : ℕ}
    (x : (orderedComplexSSet M).nonDegenerate n) (r : ℕ)
    (τ : facesIn M r (nonDegenerateSimplexFacet M x)) :
    (nonDegenerateSimplexSupportMap M x).mapSimplex
        (faceInToSupportSimplex M x r τ) = τ.1 := by
  apply Subtype.ext
  ext v
  simp [faceInToSupportSimplex, nonDegenerateSimplexSupportMap,
    OrderedSimplicialMap.mapSimplex]
  have hτ := τ.2
  change τ.1.1 ⊆ (nonDegenerateSimplexFacet M x).1 at hτ
  exact fun hv => hτ hv

/-- The elementary identification of local coordinates with cochains on the
full support simplex is injective. -/
theorem localCochainToStandard_injective
    (M : AbstractSimplicialComplex V) {n : ℕ}
    (x : (orderedComplexSSet M).nonDegenerate n) (r : ℕ) :
    Function.Injective (localCochainToStandard (G := G) M x r) := by
  intro a a' haa'
  ext τ
  have h := congrArg
    (fun c : Cochain (nonDegenerateSimplexSupportComplex M x) r G =>
      c (faceInToSupportSimplex M x r τ)) haa'
  change
    a ⟨(nonDegenerateSimplexSupportMap M x).mapSimplex
      (faceInToSupportSimplex M x r τ), _⟩ =
    a' ⟨(nonDegenerateSimplexSupportMap M x).mapSimplex
      (faceInToSupportSimplex M x r τ), _⟩ at h
  simpa using h

/-- An injective set map induces an injective pushforward on reduced finite
integral distributions. -/
theorem mapRedDistFn_injective_of_injective
    {X Y : Type*} (f : X → Y) (hf : Function.Injective f) :
    Function.Injective (mapRedDistFn f) := by
  intro a b hab
  apply Subtype.ext
  have hcoe := congrArg Subtype.val hab
  change mapDistFn f a.1 = mapDistFn f b.1 at hcoe
  exact Finsupp.mapDomain_injective hf hcoe

/-! ## Choosing the nondegenerate simplex carried by a facet -/

/-- The dimension of a nonempty finite simplex. -/
def nonemptySimplexDimension
    {M : AbstractSimplicialComplex V} (σ : NonemptySimplex M) : ℕ :=
  σ.1.card - 1

theorem nonemptySimplex_card_eq_dimension_add_one
    {M : AbstractSimplicialComplex V} (σ : NonemptySimplex M) :
    σ.1.card = nonemptySimplexDimension σ + 1 := by
  have hpos : 0 < σ.1.card :=
    Finset.card_pos.mpr ((M.isRelLowerSet_faces σ.2).1)
  unfold nonemptySimplexDimension
  omega

/-- A facet with `k+1` vertices, regarded as a degree-`k` oriented simplex. -/
def nonemptySimplexAsSimplex
    (M : AbstractSimplicialComplex V) (σ : NonemptySimplex M) :
    Simplex M (nonemptySimplexDimension σ) :=
  ⟨σ.1, σ.2, nonemptySimplex_card_eq_dimension_add_one σ⟩

/-- The corresponding nondegenerate simplex of the honest ordered simplicial
set. -/
def nonemptySimplexNonDegenerate
    (M : AbstractSimplicialComplex V) (σ : NonemptySimplex M) :
    (orderedComplexSSet M).nonDegenerate (nonemptySimplexDimension σ) :=
  (nonDegenerateSimplexEquiv M (nonemptySimplexDimension σ)).symm
    (nonemptySimplexAsSimplex M σ)

@[simp]
theorem nonemptySimplexNonDegenerate_facet
    (M : AbstractSimplicialComplex V) (σ : NonemptySimplex M) :
    nonDegenerateSimplexFacet M (nonemptySimplexNonDegenerate M σ) = σ := by
  apply Subtype.ext
  change orderedSimplexSupport
      (nonemptySimplexNonDegenerate M σ).1.1 = σ.1
  have h := (nonDegenerateSimplexEquiv M
    (nonemptySimplexDimension σ)).apply_symm_apply
      (nonemptySimplexAsSimplex M σ)
  exact congrArg (fun s : Simplex M (nonemptySimplexDimension σ) => s.1) h

/-- Evaluate a local cochain on the full simplex carried by the support of a
nondegenerate ambient simplex. -/
def localCochainLValue
    (M : AbstractSimplicialComplex V) (q n : ℕ)
    (x : (orderedComplexSSet M).nonDegenerate n) :
    Configuration (facesIn M q (nonDegenerateSimplexFacet M x)) G →
      (L (AddCommGrpCat.of G) (q + 1)).obj
        (Opposite.op (SimplexCategory.mk n)) :=
  fun a => cochainLValue (nonDegenerateSimplexSupportComplex M x) q
    (Opposite.op (SimplexCategory.mk n))
    (nonDegenerateSimplexSupportTop M x)
    (localCochainToStandard M x q a)

/-- Evaluation on a nondegenerate simplex depends only on the primitive
cochain restricted to its support. -/
theorem localCochainLValue_restrict
    (M : AbstractSimplicialComplex V) (q n : ℕ)
    (x : (orderedComplexSSet M).nonDegenerate n)
    (c : Cochain M q G) :
    localCochainLValue M q n x
        (restrictCochain M q (nonDegenerateSimplexFacet M x) c) =
      cochainLValue M q (Opposite.op (SimplexCategory.mk n)) x.1 c := by
  let F := nonDegenerateSimplexSupportMap M x
  change cochainLValue (nonDegenerateSimplexSupportComplex M x) q _
      (nonDegenerateSimplexSupportTop M x)
        (localCochainToStandard M x q
          (restrictCochain M q (nonDegenerateSimplexFacet M x) c)) = _
  rw [localCochainToStandard_restrictCochain]
  exact cochainLValue_pullback F q _
    (nonDegenerateSimplexSupportTop M x) c

/-- The local evaluation function used above is injective. -/
theorem localCochainLValue_injective
    (M : AbstractSimplicialComplex V) (q n : ℕ)
    (x : (orderedComplexSSet M).nonDegenerate n) :
    Function.Injective (localCochainLValue (G := G) M q n x) := by
  intro a a' haa'
  apply localCochainToStandard_injective M x q
  apply supportCochainLValue_injective M q x
  exact haa'

/-- A locally-zero primitive distribution evaluates to zero on every
nondegenerate simplex. -/
theorem locallyZero_globalRestriction_nonDegenerate
    (M : AbstractSimplicialComplex V) (q n : ℕ)
    (u : fCompatibleRedDist (facetRestrictionData (G := G) M q))
    (hu : u ∈ locallyZeroInFCompatible
      (facetRestrictionData (G := G) M q))
    (x : (orderedComplexSSet M).nonDegenerate n) :
    (globalCochainRestrictionMap M q
      (u : RedDist (Cochain M q G))).app
        (Opposite.op (SimplexCategory.mk n)) x.1 = 0 := by
  let σ := nonDegenerateSimplexFacet M x
  have hulocal : (u : RedDist (Cochain M q G)) ∈
      (facetRestrictionData (G := G) M q).locallyZeroRedDist := hu
  rw [locallyZeroRedDist, Submodule.mem_iInf] at hulocal
  have hlocal := LinearMap.mem_ker.mp (hulocal σ)
  change mapRedDist (restrictCochain (G := G) M q σ)
      (u : RedDist (Cochain M q G)) = 0 at hlocal
  rw [globalCochainRestrictionMap_app_apply]
  have hfactor :
      cochainLValue M q (Opposite.op (SimplexCategory.mk n)) x.1 =
        localCochainLValue M q n x ∘
          restrictCochain (G := G) M q σ := by
    funext c
    exact (localCochainLValue_restrict M q n x c).symm
  rw [hfactor, ← mapRedDistFn_comp_apply,
    ← mapRedDist_eq_mapRedDistFn, hlocal]
  exact map_zero _

/-- Facetwise-zero primitive distributions give the zero genuine simplicial
map. -/
theorem locallyZero_globalRestriction_eq_zero
    (M : AbstractSimplicialComplex V) (q : ℕ)
    (u : fCompatibleRedDist (facetRestrictionData (G := G) M q))
    (hu : u ∈ locallyZeroInFCompatible
      (facetRestrictionData (G := G) M q)) :
    globalCochainRestrictionMap M q
        (u : RedDist (Cochain M q G)) = 0 := by
  ext Δ z
  induction Δ using Opposite.rec with
  | _ Δ =>
    induction Δ using SimplexCategory.rec with
    | _ n =>
      change (globalCochainRestrictionMap M q
        (u : RedDist (Cochain M q G))).app
          (Opposite.op (SimplexCategory.mk n)) z = 0
      obtain ⟨m, f, _, y, hz⟩ :=
        (orderedComplexSSet M).exists_nonDegenerate z
      rw [hz]
      have hy := locallyZero_globalRestriction_nonDegenerate M q m u hu y
      calc
        _ = (underlyingSSet
              (reducedFree (L (AddCommGrpCat.of G) (q + 1)))).map f.op
              ((globalCochainRestrictionMap M q
                (u : RedDist (Cochain M q G))).app
                  (Opposite.op (SimplexCategory.mk m)) y.1) := by
            exact underlyingSSetMap_naturality_apply
              (globalCochainRestrictionMap M q
                (u : RedDist (Cochain M q G))) f.op y.1
        _ = 0 := by
          rw [hy]
          change (reducedFree (L (AddCommGrpCat.of G) (q + 1))).map f.op 0 = 0
          exact map_zero _

set_option maxHeartbeats 800000 in
-- Specializing equality with the large Dold--Kan target at a chosen simplex
-- requires more elaboration than the pointwise algebra that follows.
/-- Conversely, if genuine simplexwise evaluation is zero, then the
primitive distribution vanishes after restriction to every facet. -/
theorem globalRestriction_eq_zero_locallyZero
    (M : AbstractSimplicialComplex V) (q : ℕ)
    (u : fCompatibleRedDist (facetRestrictionData (G := G) M q))
    (hzero : globalCochainRestrictionMap M q
      (u : RedDist (Cochain M q G)) = 0) :
    u ∈ locallyZeroInFCompatible
      (facetRestrictionData (G := G) M q) := by
  change (u : RedDist (Cochain M q G)) ∈
    (facetRestrictionData (G := G) M q).locallyZeroRedDist
  rw [locallyZeroRedDist, Submodule.mem_iInf]
  intro σ
  rw [LinearMap.mem_ker]
  change mapRedDist (restrictCochain (G := G) M q σ)
      (u : RedDist (Cochain M q G)) = 0
  let n := nonemptySimplexDimension σ
  let x := nonemptySimplexNonDegenerate M σ
  have hσ : nonDegenerateSimplexFacet M x = σ := by
    exact nonemptySimplexNonDegenerate_facet M σ
  rw [← hσ]
  have hxzero :
      (globalCochainRestrictionMap M q
        (u : RedDist (Cochain M q G))).app
          (Opposite.op (SimplexCategory.mk n)) x.1 = 0 := by
    have hpoint := congrArg
      (fun f : orderedComplexSSet M ⟶
          underlyingSSet (reducedFree (L (AddCommGrpCat.of G) (q + 1))) =>
        f.app (Opposite.op (SimplexCategory.mk n)) x.1) hzero
    exact hpoint
  rw [globalCochainRestrictionMap_app_apply] at hxzero
  have hfactor :
      cochainLValue M q (Opposite.op (SimplexCategory.mk n)) x.1 =
        localCochainLValue M q n x ∘
          restrictCochain (G := G) M q
            (nonDegenerateSimplexFacet M x) := by
    funext c
    exact (localCochainLValue_restrict M q n x c).symm
  rw [hfactor, ← mapRedDistFn_comp_apply] at hxzero
  rw [mapRedDist_eq_mapRedDistFn]
  apply mapRedDistFn_injective_of_injective
    (localCochainLValue M q n x)
    (localCochainLValue_injective M q n x)
  simpa using hxzero

/-- Exact kernel calculation for genuine cochain-distribution evaluation. -/
theorem fCompatible_globalRestriction_kernel
    (M : AbstractSimplicialComplex V) (q : ℕ)
    (u : fCompatibleRedDist (facetRestrictionData (G := G) M q)) :
    globalCochainRestrictionMap M q
          (u : RedDist (Cochain M q G)) = 0 ↔
      u ∈ locallyZeroInFCompatible
        (facetRestrictionData (G := G) M q) :=
  ⟨globalRestriction_eq_zero_locallyZero M q u,
    locallyZero_globalRestriction_eq_zero M q u⟩

end GeneralSphereT.SimplicialCochain
