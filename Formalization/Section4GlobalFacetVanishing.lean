import Formalization.Section4StrictFSectionsNativeKernel

set_option linter.style.header false
set_option backward.isDefEq.respectTransparency false

/-!
# Section 4: vanishing on one support simplex

Facetwise vanishing is often used one facet at a time.  This file records
the local form: if a cochain distribution restricts to zero on the support
of one nondegenerate simplex, then its genuine global Dold--Kan evaluation
vanishes on the whole full simplex generated by that support.
-/

noncomputable section

open CategoryTheory CategoryTheory.Category Opposite Simplicial

namespace GeneralSphereT.SimplicialCochain

open GeneralSphereT.PathAlgebra
open GeneralSphereT.StandardModels
open GeneralSphereT.Section4
open GeneralSphereT.Section4.UnderlyingSSet

universe u

variable {V G : Type u} [LinearOrder V] [Fintype V] [AddCommGroup G]

/-- Zero restriction to one support facet forces zero evaluation on its top
nondegenerate simplex. -/
theorem globalRestriction_nonDegenerate_eq_zero_of_restrict_eq_zero
    (M : AbstractSimplicialComplex V) (q n : ℕ)
    (u : RedDist (Cochain M q G))
    (x : (orderedComplexSSet M).nonDegenerate n)
    (hlocal : mapRedDist
        (restrictCochain (G := G) M q (nonDegenerateSimplexFacet M x)) u = 0) :
    (globalCochainRestrictionMap M q u).app
        (Opposite.op (SimplexCategory.mk n)) x.1 = 0 := by
  rw [globalCochainRestrictionMap_app_apply]
  have hfactor :
      cochainLValue M q (Opposite.op (SimplexCategory.mk n)) x.1 =
        localCochainLValue M q n x ∘
          restrictCochain (G := G) M q
            (nonDegenerateSimplexFacet M x) := by
    funext c
    exact (localCochainLValue_restrict M q n x c).symm
  rw [hfactor, ← mapRedDistFn_comp_apply,
    ← mapRedDist_eq_mapRedDistFn, hlocal]
  exact map_zero _

/-- Under the same local hypothesis, evaluation vanishes on every face and
degeneracy of the chosen simplex, i.e. after pullback to its full support
simplex. -/
theorem supportMap_comp_globalRestriction_eq_zero_of_restrict_eq_zero
    (M : AbstractSimplicialComplex V) (q n : ℕ)
    (u : RedDist (Cochain M q G))
    (x : (orderedComplexSSet M).nonDegenerate n)
    (hlocal : mapRedDist
        (restrictCochain (G := G) M q (nonDegenerateSimplexFacet M x)) u = 0) :
    (nonDegenerateSimplexSupportMap M x).toSSetMap ≫
        globalCochainRestrictionMap M q u = 0 := by
  let f := (nonDegenerateSimplexSupportMap M x).toSSetMap ≫
    globalCochainRestrictionMap M q u
  have htop : f.app (Opposite.op (SimplexCategory.mk n))
      (nonDegenerateSimplexSupportTop M x) = 0 := by
    change (globalCochainRestrictionMap M q u).app
      (Opposite.op (SimplexCategory.mk n))
        ((nonDegenerateSimplexSupportMap M x).toSSetMap.app
          (Opposite.op (SimplexCategory.mk n))
            (nonDegenerateSimplexSupportTop M x)) = 0
    rw [nonDegenerateSimplexSupportMap_top]
    exact globalRestriction_nonDegenerate_eq_zero_of_restrict_eq_zero
      M q n u x hlocal
  ext Δ z
  let θ := (nonDegenerateSimplexSupportHom M x z).op
  have hnat := underlyingSSetMap_naturality_apply f θ
    (nonDegenerateSimplexSupportTop M x)
  have hz := nonDegenerateSimplexSupport_map_hom_top M x z
  change f.app Δ z = 0
  rw [← hz]
  calc
    f.app Δ
        ((orderedComplexSSet
          (nonDegenerateSimplexSupportComplex M x)).map θ
            (nonDegenerateSimplexSupportTop M x)) =
      (underlyingSSet
        (reducedFree (L (AddCommGrpCat.of G) (q + 1)))).map θ
          (f.app (Opposite.op (SimplexCategory.mk n))
            (nonDegenerateSimplexSupportTop M x)) := hnat
    _ = 0 := by
      rw [htop]
      change (reducedFree (L (AddCommGrpCat.of G) (q + 1))).map θ 0 = 0
      exact map_zero _

end GeneralSphereT.SimplicialCochain
