import Formalization.Section4StrictFSectionsNativeSurjective
import Formalization.Section4GlobalBasepointEvaluation
import Formalization.Section4NativePointedMappingSpace
import Formalization.Section4RprimBasedNativeMap

set_option linter.style.header false
set_option backward.isDefEq.respectTransparency false

/-!
# Section 4: based strict sections as genuine pointed maps

This file restricts the strict-section/native-fibre comparison to the kernel
of basepoint evaluation.  The only point requiring verification is that
algebraic evaluation on the singleton facet is exactly the native condition
of vanishing on the whole simplicial subcomplex generated by the vertex.
-/

noncomputable section

open CategoryTheory CategoryTheory.Category Opposite Simplicial

namespace GeneralSphereT.SimplicialCochain

open GeneralSphereT.PathAlgebra
open GeneralSphereT.PathAlgebra.FacetRestrictionData
open GeneralSphereT.StandardModels
open GeneralSphereT.Section4
open GeneralSphereT.Section4.RelativeMapping
open GeneralSphereT.Section4.NativeRelativeHomotopyGroup

universe u

variable {V G : Type u} [LinearOrder V] [Fintype V] [AddCommGroup G]

private abbrev LData (M : AbstractSimplicialComplex V) (q : ℕ) :=
  facetRestrictionData (G := G) M q

private abbrev BasedSections
    (M : AbstractSimplicialComplex V) (b : V) (q : ℕ) :=
  (simplicialBasepointRowData (G := G) M b q).BasedSections

/-- The native fibre map represented by an algebraic strict section. -/
def strictFSectionToNativeFiberMap
    (M : AbstractSimplicialComplex V) (q : ℕ) :
    StrictFSections (LData (G := G) M q) →ₗ[ℤ]
      (orderedComplexSSet M ⟶
        underlyingSSet (F (AddCommGrpCat.of G) (q + 1))) :=
  (strictFSectionsLinearEquivNativeFiberMaps (G := G) M q).toLinearMap

/-- Basepoint evaluation on a strict section is zero exactly when its actual
fibre-valued simplicial map is pointed. -/
theorem strictFSectionToNativeFiberMap_basepoint_eq_zero_iff
    (M : AbstractSimplicialComplex V) (b : V) (q : ℕ)
    (x : StrictFSections (LData (G := G) M q)) :
    (orderedComplexBasepointSubcomplex M b).ι ≫
          strictFSectionToNativeFiberMap (G := G) M q x = 0 ↔
      evalStrictFSections (LData (G := G) M q)
          (basepointFacet M b) x = 0 := by
  refine Submodule.Quotient.induction_on
    (p := locallyZeroInFCompatible (LData (G := G) M q)) x ?_
  intro u
  change
    (orderedComplexBasepointSubcomplex M b).ι ≫
          strictFSectionToNativeFiberMap (G := G) M q
            ((locallyZeroInFCompatible (LData (G := G) M q)).mkQ u) = 0 ↔
      evalStrictFSections (LData (G := G) M q)
          (basepointFacet M b)
            ((locallyZeroInFCompatible (LData (G := G) M q)).mkQ u) = 0
  let f := fCompatibleToNativeKilled M q
    (strictFSectionsNativeInput (G := G) M q) u
  have hfiber : strictFSectionToNativeFiberMap (G := G) M q
        ((locallyZeroInFCompatible (LData (G := G) M q)).mkQ u) =
      MapsKilledByD.toFiberMap (orderedComplexSSet M)
        (AddCommGrpCat.of G) (q + 1) f := by
    rfl
  rw [hfiber, evalStrictFSections_mkQ]
  let P := orderedComplexBasepointSubcomplex M b
  let iF := underlyingMap (Fι (AddCommGrpCat.of G) (q + 1))
  constructor
  · intro h
    apply (fCompatible_basepoint_native_eq_zero_iff M b q u).1
    calc
      P.ι ≫ globalCochainRestrictionMap M q
            (u : RedDist (Cochain M q G)) =
          P.ι ≫
            (MapsKilledByD.toFiberMap (orderedComplexSSet M)
              (AddCommGrpCat.of G) (q + 1) f ≫ iF) := by
                rw [MapsKilledByD.toFiberMap_comp_inclusion]
                rfl
      _ = (P.ι ≫
            MapsKilledByD.toFiberMap (orderedComplexSSet M)
              (AddCommGrpCat.of G) (q + 1) f) ≫ iF :=
        (Category.assoc _ _ _).symm
      _ = 0 ≫ iF := congrArg (fun k ↦ k ≫ iF) h
      _ = 0 := by
        ext Δ y
        change ((Fι (AddCommGrpCat.of G) (q + 1)).app Δ).hom 0 = 0
        exact map_zero ((Fι (AddCommGrpCat.of G) (q + 1)).app Δ).hom
  · intro h
    apply (cancel_mono iF).1
    rw [Category.assoc, MapsKilledByD.toFiberMap_comp_inclusion]
    have hglobal := (fCompatible_basepoint_native_eq_zero_iff M b q u).2 h
    calc
      (orderedComplexBasepointSubcomplex M b).ι ≫ (f :
          orderedComplexSSet M ⟶
            underlyingSSet
              (reducedFree (L (AddCommGrpCat.of G) (q + 1)))) =
        (orderedComplexBasepointSubcomplex M b).ι ≫
          globalCochainRestrictionMap M q
            (u : RedDist (Cochain M q G)) := rfl
      _ = 0 := hglobal
      _ = 0 ≫ iF := by
        ext Δ y
        change 0 = ((Fι (AddCommGrpCat.of G) (q + 1)).app Δ).hom 0
        exact (map_zero
          ((Fι (AddCommGrpCat.of G) (q + 1)).app Δ).hom).symm

/-- Restrict the strict-section comparison to based sections, obtaining
actual pointed simplicial maps rather than a formal kernel. -/
def basedStrictFSectionsToNativePointedMap
    (M : AbstractSimplicialComplex V) (b : V) (q : ℕ) :
    BasedSections (G := G) M b q →ₗ[ℤ]
      NativePointedMaps M b (AddCommGrpCat.of G) (q + 1) where
  toFun x :=
    { map := strictFSectionToNativeFiberMap (G := G) M q x.1
      comm := by
        rw [zeroBoundary_comp_inclusion]
        exact (strictFSectionToNativeFiberMap_basepoint_eq_zero_iff
          M b q x.1).2 x.2 }
  map_add' x y := by
    apply SSet.RelativeMorphism.ext
    exact map_add (strictFSectionToNativeFiberMap (G := G) M q) x.1 y.1
  map_smul' n x := by
    apply SSet.RelativeMorphism.ext
    exact map_smul (strictFSectionToNativeFiberMap (G := G) M q) n x.1

@[simp]
theorem basedStrictFSectionsToNativePointedMap_map
    (M : AbstractSimplicialComplex V) (b : V) (q : ℕ)
    (x : BasedSections (G := G) M b q) :
    (basedStrictFSectionsToNativePointedMap (G := G) M b q x).map =
      strictFSectionToNativeFiberMap (G := G) M q x.1 :=
  rfl

/-- The restricted comparison remains injective. -/
theorem basedStrictFSectionsToNativePointedMap_injective
    (M : AbstractSimplicialComplex V) (b : V) (q : ℕ) :
    Function.Injective
      (basedStrictFSectionsToNativePointedMap (G := G) M b q) := by
  intro x y hxy
  apply Subtype.ext
  apply (strictFSectionsLinearEquivNativeFiberMaps (G := G) M q).injective
  exact congrArg SSet.RelativeMorphism.map hxy

/-- Every genuine pointed fibre map comes from a based strict section. -/
theorem basedStrictFSectionsToNativePointedMap_surjective
    (M : AbstractSimplicialComplex V) (b : V) (q : ℕ) :
    Function.Surjective
      (basedStrictFSectionsToNativePointedMap (G := G) M b q) := by
  intro f
  let e := strictFSectionsLinearEquivNativeFiberMaps (G := G) M q
  let x : StrictFSections (LData (G := G) M q) := e.symm f.map
  have hxmap : strictFSectionToNativeFiberMap (G := G) M q x = f.map := by
    exact e.apply_symm_apply f.map
  have hfpointed :
      (orderedComplexBasepointSubcomplex M b).ι ≫ f.map = 0 := by
    calc
      (orderedComplexBasepointSubcomplex M b).ι ≫ f.map =
          zeroBoundary (orderedComplexBasepointSubcomplex M b)
              (F (AddCommGrpCat.of G) (q + 1)) ≫
            (zeroSubcomplex (F (AddCommGrpCat.of G) (q + 1))).ι := f.comm
      _ = 0 := zeroBoundary_comp_inclusion
        (orderedComplexBasepointSubcomplex M b)
          (F (AddCommGrpCat.of G) (q + 1))
  have hxbase :
      evalStrictFSections (LData (G := G) M q)
          (basepointFacet M b) x = 0 :=
    (strictFSectionToNativeFiberMap_basepoint_eq_zero_iff
      M b q x).1 (by simpa only [hxmap] using hfpointed)
  refine ⟨⟨x, hxbase⟩, ?_⟩
  apply SSet.RelativeMorphism.ext
  exact hxmap

/-- Based algebraic strict sections are linearly equivalent to the actual
pointed mapping group into the standard Dold--Kan fibre. -/
def basedStrictFSectionsLinearEquivNativePointedMaps
    (M : AbstractSimplicialComplex V) (b : V) (q : ℕ) :
    BasedSections (G := G) M b q ≃ₗ[ℤ]
      NativePointedMaps M b (AddCommGrpCat.of G) (q + 1) :=
  LinearEquiv.ofBijective
    (basedStrictFSectionsToNativePointedMap (G := G) M b q)
    ⟨basedStrictFSectionsToNativePointedMap_injective (G := G) M b q,
      basedStrictFSectionsToNativePointedMap_surjective (G := G) M b q⟩

@[simp]
theorem basedStrictFSectionsLinearEquivNativePointedMaps_apply
    (M : AbstractSimplicialComplex V) (b : V) (q : ℕ)
    (x : BasedSections (G := G) M b q) :
    basedStrictFSectionsLinearEquivNativePointedMaps (G := G) M b q x =
      basedStrictFSectionsToNativePointedMap (G := G) M b q x :=
  rfl

/-- The based restriction arrow agrees on the nose with direct native
evaluation of a based primitive relation. -/
theorem basedStrictFSectionsToNativePointedMap_comp_basedRestriction
    (M : AbstractSimplicialComplex V) (b : V) (q : ℕ) :
    (basedStrictFSectionsToNativePointedMap (G := G) M b q).comp
        (simplicialBasepointRowData (G := G) M b q).basedRestriction =
      basedRprimToNativePointedMap M b q := by
  apply LinearMap.ext
  intro r
  apply SSet.RelativeMorphism.ext
  apply (cancel_mono
    (underlyingMap (Fι (AddCommGrpCat.of G) (q + 1)))).1
  change
    (strictFSectionToNativeFiberMap (G := G) M q
        ((simplicialBasepointRowData (G := G) M b q).basedRestriction r)) ≫
          underlyingMap (Fι (AddCommGrpCat.of G) (q + 1)) =
      rprimToNativeFiberMap M q r.1 ≫
        underlyingMap (Fι (AddCommGrpCat.of G) (q + 1))
  rw [rprimToNativeFiberMap_comp_inclusion]
  change MapsKilledByD.toFiberMap (orderedComplexSSet M)
      (AddCommGrpCat.of G) (q + 1)
        (fCompatibleToNativeKilled M q
          (strictFSectionsNativeInput (G := G) M q)
          (rprimToFCompatible (LData (G := G) M q) r.1)) ≫
      underlyingMap (Fι (AddCommGrpCat.of G) (q + 1)) = _
  rw [MapsKilledByD.toFiberMap_comp_inclusion]
  rfl

end GeneralSphereT.SimplicialCochain
